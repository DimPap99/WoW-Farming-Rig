{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        // The data sync's HTTP client: every request, and each retry and failed attempt (with its
        // stack trace) while the Pathing Service is down, would reach the Control Center's console.
        // The sync says what matters in one line. Polly never logs at Fatal.
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Fatal",

        "Game.WowProcessInput": "Warning",
        "Core.ConfigurableInput": "Warning",
        "Core.Goals.Navigation": "Information"
      }
    }
  },
  "Navmesh": {
    "Bake": {
      "AgentRadius": 0.5,
      "AgentMaxClimb": 1.6,
      "WalkableSlope": 48,
      "MinWorldZ": { "Expansion01": -700 }
    },
    "Query": {
      "EdgeMargin": 1.5,
      "PathSpacing": 2.5,
      "CorridorTiles": 2,
      "CorridorMaxTiles": 4,
      "CorridorWiden": true,
      "SkipWidenShortRoutes": true,
      "RoadCore": 8
    }
  },
  "SplineFollower": {
    "Enabled": false
  },
  // The resident agent (--agent). Its id is kept in IdentityFile; Name is what the Bot Manager
  // calls it (the machine name when empty). A stopped run gets StopGraceMs to release and end.
  "Agent": {
    "IdentityFile": "agent_identity.json",
    "Name": "",
    "StopGraceMs": 10000
  },
  // The Bot Manager to dial out to (--manager); empty runs on its own. A manager on another PC
  // needs the key: "ApiKey" here or in the environment, the same on every service and agent.
  "BotManager": {
    "Url": ""
  },
  // The Pathing Service a run's files are synced from before it starts (--pathing-service): its
  // route, the profile's paths, the cost zones. Empty: runs use this PC's copies. The same key.
  "PathingService": {
    "Url": ""
  }
}