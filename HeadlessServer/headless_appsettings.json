{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",

        "Game.WowProcessInput": "Warning",
        "Core.ConfigurableInput": "Warning",
        "Core.Goals.Navigation": "Information"
      }
    }
  },
  "Navmesh": {
    "Bake": {
      "AgentRadius": 0.5,
      "AgentMaxClimb": 1.6,
      "WalkableSlope": 48,
      "MinWorldZ": { "Expansion01": -700 }
    },
    "Query": {
      "EdgeMargin": 1.5,
      "PathSpacing": 2.5,
      "CorridorTiles": 2,
      "CorridorMaxTiles": 4,
      "CorridorWiden": true,
      "SkipWidenShortRoutes": true,
      "RoadCore": 8
    }
  },
  "SplineFollower": {
    "Enabled": false
  },
  // The resident agent (--agent). Its id is kept in IdentityFile; Name is what the Bot Manager
  // calls it (the machine name when empty). A stopped run gets StopGraceMs to release and end.
  "Agent": {
    "IdentityFile": "agent_identity.json",
    "Name": "",
    "StopGraceMs": 10000
  },
  // The Bot Manager to dial out to (--manager); empty runs on its own. A manager on another PC
  // needs the key: "ApiKey" here or in the environment, the same on every service and agent.
  "BotManager": {
    "Url": ""
  }
}