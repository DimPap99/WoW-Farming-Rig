<nav class="pa-nav">
    @foreach (NavSection group in Sections)
    {
        <div class="pa-nav-section">@group.Title</div>
        @foreach (NavItem item in group.Items)
        {
            <NavLink class="pa-nav-link" href="@item.Href" Match="@item.Match" title="@item.Hint">
                <span class="oi oi-@item.Icon" aria-hidden="true"></span>
                <span class="pa-nav-label">@item.Label</span>
            </NavLink>
        }
    }
</nav>

@code {
    private sealed record NavItem(string Label, string Href, string Icon, string Hint,
        NavLinkMatch Match = NavLinkMatch.Prefix);

    private sealed record NavSection(string Title, NavItem[] Items);

    private static readonly NavSection[] Sections =
    [
        new("Views",
        [
            new("Live view", "", "pulse", "3D view of every route the Pathing Service plans, and the test routes", NavLinkMatch.All),
            new("Map", "Leaflet", "map", "The minimap with spawns, zones, cost zones, navmesh coverage and bakes"),
        ]),
        new("Bots",
        [
            new("Fleet", "fleet", "monitor", "Every bot the Bot Manager knows: its state, its assignment, Start and Stop, and its console"),
        ]),
        new("Tools",
        [
            new("Routes", "routes", "signpost", "Plan a route on the map, between places or points you click: the bot's band search or across the whole continent"),
            new("Route search", "search", "magnifying-glass", "Plan a route between named places"),
            new("Path library", "paths", "map-marker", "Recorded paths: draw, search their legs, edit and delete"),
            new("NPC routes", "npc-routes", "people", "Route to an NPC of a type in a zone"),
            new("Forever routes", "forever-routes", "list", "WoW: Forever route files: check, edit and save them as text"),
        ]),
        new("Reference",
        [
            new("API", "api-reference", "code", "Swagger: every Pathing Service endpoint, with examples"),
        ]),
    ];
}
