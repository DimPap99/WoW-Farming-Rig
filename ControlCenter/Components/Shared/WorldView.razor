@* The world view: one map for every page that shows the world, flat and north-up, tilting into 3D,
   drawn with deck.gl by wwwroot/js/world-view.js (and world-edit.js for drawing). The page owns what
   is shown (Scene, sent whole when it changes), hears clicks on the map while Picking, and offers
   drawing Tools: what they draw, and what the pointer changes on an editable shape, comes back as
   events for the page to keep. The ground - the continent's relief, and each tile's walkable
   polygons when zoomed in - the view fetches itself from the Pathing Service, so it needs no
   minimap art. Drag pans, the wheel zooms, right-drag turns and tilts. *@

@inherits ControlCenterComponent
@implements IAsyncDisposable

@inject IJSRuntime js

<div class="pa-world @(Picking ? "is-picking" : null)" @ref="host">
    <div class="pa-world-canvas"></div>

    <div class="pa-world-tools">
        <div class="pa-group" role="group" aria-label="View">
            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(tilted)" @onclick="ToggleTiltAsync"
                    title="Tilt the map to see heights; right-drag turns and tilts it">3D</button>
            <button class="pa-toggle" type="button" @onclick="FitAsync" title="Frame what this page shows">Fit</button>
            <button class="pa-toggle pa-world-art" type="button" aria-pressed="@Aria.State(art)" @onclick="ToggleArtAsync"
                    title="The game's map under the routes: its minimap, as the Leaflet map showed it">Map</button>
        </div>

        @if (Tools is { Length: > 0 })
        {
            <div class="pa-group pa-world-draw" role="group" aria-label="Draw">
                <span class="pa-group-label" aria-hidden="true">Draw</span>
                @foreach (WorldTool tool in Tools)
                {
                    <button class="pa-toggle pa-world-tool" type="button" aria-pressed="@Aria.State(Tool == tool.Shape)"
                            title="@tool.Title" aria-label="@tool.Title" data-tool="@tool.Shape" @onclick="() => ChooseAsync(tool.Shape)">
                        @Icon(tool.Shape)
                        <span class="pa-world-tool-name">@tool.Label</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="pa-world-readout" aria-hidden="true"></div>

    @if (failed is not null)
    {
        <div class="pa-world-failed"><ResultLine Text="@failed" Kind="ResultKind.Error" /></div>
    }

    @ChildContent
</div>

@code {
    /// <summary>What the page shows; a new instance is sent to the view, the same one is not.</summary>
    [Parameter, EditorRequired] public WorldScene Scene { get; set; } = WorldScene.Empty(string.Empty);

    /// <summary>While set, a click on the map is reported to <see cref="OnPick"/>.</summary>
    [Parameter] public bool Picking { get; set; }

    [Parameter] public EventCallback<WorldPoint> OnPick { get; set; }

    /// <summary>The drawing tools shown on the map; none when null.</summary>
    [Parameter] public WorldTool[]? Tools { get; set; }

    /// <summary>The tool in use, one of <see cref="WorldShapes"/>; null for none. Escape on the map drops it.</summary>
    [Parameter] public string? Tool { get; set; }

    [Parameter] public EventCallback<string?> ToolChanged { get; set; }

    /// <summary>A shape the tool in use finished.</summary>
    [Parameter] public EventCallback<WorldDrawn> OnDrawn { get; set; }

    /// <summary>An editable shape the pointer changed.</summary>
    [Parameter] public EventCallback<WorldEdited> OnEdited { get; set; }

    /// <summary>A shape was clicked: its id; null when a click beside every shape lets the selection go.</summary>
    [Parameter] public EventCallback<string?> OnSelected { get; set; }

    /// <summary>A marker was clicked, while not <see cref="Picking"/> and with no tool: its id.</summary>
    [Parameter] public EventCallback<string> OnMarker { get; set; }

    /// <summary>Panels shown over the view.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // The service's routes the view fetches its ground from, and what it names the pointer's place
    // with (the zone maps, the area grid), forwarded by this host.
    private static readonly object Urls = new
    {
        overview = $"{PathingApi.Navmesh}/{{continent}}/{PathingApi.Overview}",
        tile = $"{PathingApi.Navmesh}/{{continent}}/{PathingApi.Tiles}/{{x}}/{{z}}",
        world = PathingApi.World,
        area = $"{PathingApi.Area}?mapId={{mapId}}&x={{x}}&y={{y}}",
        art = $"{WorldData.Tiles}/{{continent}}/z{{z}}x{{x}}y{{y}}.webp",
    };

    // Whether the map art shows, remembered in this browser; on until turned off.
    private const string ArtKey = "cc.world.art";

    // Not a tool: the page's tool differs from it, so it is sent on the next render.
    private const string ResendTool = "\0";

    private ElementReference host;
    private DotNetObjectReference<WorldView>? self;
    private string? id;
    private WorldScene? shown;
    private WorldScene? seen;
    // A scene asked to be framed, and a later one replaced it before it was sent (the view was still
    // being made, or answers came quickly): the framing still happens, with the latest scene.
    private bool frameWanted;
    private float[]? frameOnWanted;
    private bool? pickingShown;
    private string? toolShown;
    private bool tilted;
    private bool art = true;
    private string? failed;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Scene, seen))
        {
            seen = Scene;
            frameWanted |= Scene.Frame;
            frameOnWanted = Scene.FrameOn ?? frameOnWanted;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                self = DotNetObjectReference.Create(this);
                art = await js.InvokeAsync<string?>("pathingUi.storageGet", Token, ArtKey) != "0";
                id = await js.InvokeAsync<string>("worldView.create", Token, host, self, new { urls = Urls, art });
                if (!art)
                {
                    StateHasChanged();
                }
            }

            if (id is null)
            {
                return;
            }

            if (!ReferenceEquals(Scene, shown))
            {
                shown = Scene;
                WorldScene sending = Scene with { Frame = frameWanted, FrameOn = frameOnWanted };
                frameWanted = false;
                frameOnWanted = null;
                await js.InvokeVoidAsync("worldView.setScene", Token, id, sending);
            }

            if (pickingShown != Picking)
            {
                pickingShown = Picking;
                await js.InvokeVoidAsync("worldView.setPicking", Token, id, Picking);
            }

            if (toolShown != Tool)
            {
                toolShown = Tool;
                await js.InvokeVoidAsync("worldView.setTool", Token, id, Tool);
            }
        }
        catch (JSException e)
        {
            // deck.gl could not be fetched, or a scene broke the script: said here, not thrown into the circuit.
            failed = $"The map could not be drawn: {e.Message}";
            StateHasChanged();
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException)
        {
            // The page went away.
        }
    }

    /// <summary>Centres the view on a world point, closing in when it is zoomed far out.</summary>
    public Task CenterOnAsync(Point3 at)
    {
        return Js("worldView.centerOn", at.X, at.Y);
    }
    /// <summary>A click on the map while <see cref="Picking"/>: world yards, and the ground's height under it, else 0.</summary>
    [JSInvokable]
    public Task OnWorldClick(float x, float y, float z)
    {
        return OnPick.InvokeAsync(new WorldPoint(x, y, z));
    }

    [JSInvokable]
    public Task OnShapeDrawn(string shape, float[] points, float radius, string? marker)
    {
        return OnDrawn.InvokeAsync(new WorldDrawn(shape, WorldPoints.Unflatten(points), radius, marker));
    }

    [JSInvokable]
    public Task OnShapeEdited(string shapeId, float[] points, float radius)
    {
        return OnEdited.InvokeAsync(new WorldEdited(shapeId, WorldPoints.Unflatten(points), radius));
    }

    [JSInvokable]
    public Task OnShapeSelected(string? shapeId)
    {
        return OnSelected.InvokeAsync(shapeId);
    }

    [JSInvokable]
    public Task OnMarkerClicked(string markerId)
    {
        return OnMarker.InvokeAsync(markerId);
    }

    [JSInvokable]
    public Task OnToolCleared()
    {
        toolShown = ResendTool;
        return ToolChanged.InvokeAsync(null);
    }

    // The script switched the tool when the button was pressed; whatever the page makes of it is sent
    // again after, so the two cannot drift apart.
    private Task ChooseAsync(string shape)
    {
        toolShown = ResendTool;
        return ToolChanged.InvokeAsync(Tool == shape ? null : shape);
    }

    private async Task ToggleTiltAsync()
    {
        tilted = !tilted;
        await Js("worldView.setTilt", tilted);
    }

    private Task FitAsync()
    {
        return Js("worldView.fit");
    }

    private async Task ToggleArtAsync()
    {
        art = !art;
        try
        {
            await js.InvokeVoidAsync("pathingUi.storageSet", Token, ArtKey, art ? "1" : "0");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Not remembered, still switched.
        }

        await Js("worldView.setArt", art);
    }

    private async Task Js(string identifier, params object[] args)
    {
        if (id is null)
        {
            return;
        }

        try
        {
            await js.InvokeVoidAsync(identifier, Token, [id, .. args]);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    // Each tool's picture: what it draws.
    private static RenderFragment Icon(string shape) => shape switch
    {
        WorldShapes.Point => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5A4.5 4.5 0 0 0 8 1.5z" /><circle cx="8" cy="6" r="1.6" /></svg>,
        WorldShapes.Line => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><polyline points="2,13 6,5 10,10 14,3" /></svg>,
        WorldShapes.Polygon => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><polygon points="8,2 14,6.5 11.5,14 4.5,14 2,6.5" /></svg>,
        WorldShapes.Points => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><polyline points="2.5,12.5 7,6 13.5,3.5" stroke-dasharray="2 2" /><circle cx="2.5" cy="12.5" r="1.6" /><circle cx="7" cy="6" r="1.6" /><circle cx="13.5" cy="3.5" r="1.6" /></svg>,
        WorldShapes.Rectangle => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="9" /></svg>,
        WorldShapes.Circle => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /></svg>,
        WorldShapes.Path => @<svg class="pa-world-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 12.5c2.5 0 2.2-5 5-5s2.2 4 4.5 4 2-6 2.5-8" /></svg>,
        _ => @<span>@shape</span>,
    };

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (id is not null)
        {
            await js.InvokeTeardownAsync("worldView.dispose", id);
        }

        self?.Dispose();
    }
}
