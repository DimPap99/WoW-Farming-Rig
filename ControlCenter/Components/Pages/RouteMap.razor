@using System.Threading

@inherits ControlCenterComponent
@implements IAsyncDisposable

@inject IPathingClient pathing
@inject WorldCache worldCache
@inject PathingStatus status
@inject IJSRuntime js
@inject ZoneLookup zoneLookup

@* The route designer, on ServiceClients' RouteEditor. Nodes are clicked on the map (on an NPC, a stop
   for it), added from named places, the layers or the path library, or drawn as a path; areas drawn on
   the map are roamed. Each node has a kind - shape, required, stop, area - and each leg a kind:
   replanned, the navmesh's way, planned here under the route's cost-zone choice so what is drawn is what
   the bot plans, or exact, walked as drawn. Every edit can be undone (Ctrl+Z) and redone (Ctrl+Y). The
   route is saved to the library as one zone's map coordinates, or as a Forever route file, which the
   Pathing Service checks as a run loads it; a Forever route file opens as nodes too. *@

<WorldModeView @ref="view" Scene="@scene" Tools="@Tools" @bind-Tool="tool" OnDrawn="Drawn" OnEdited="Edited" OnSelected="ShapeSelected"
           OnMarker="MarkerClickedAsync">
    <span @ref="undoAnchor" aria-hidden="true"></span>
    <Panel Title="Route" Icon="signpost" Position="top-left" Class="pa-panel--tall">
        @if (world is null)
        {
            <ResultLine Text="@(status.Online ? "Loading the world..." : "Waiting for the Pathing Service")" Kind="ResultKind.Info" />
        }
        else
        {
            RouteNode[] nodes = Design.Nodes;
            RouteStats stats = RouteStats.Of(planned);
            (string summary, ResultKind summaryKind) = Summary(planned, stats);
            <div class="pa-form">
                <div class="pa-row">
                    <div class="pa-field pa-grow">
                        <label class="pa-label" for="pa-route-continent">Continent</label>
                        <select class="pa-select" id="pa-route-continent" value="@continent" @onchange="ChangeContinent"
                                disabled="@(nodes.Length > 0)" title="@(nodes.Length > 0 ? "Clear the route to design one on another continent" : null)">
                            @foreach (ContinentInfo c in world.World.Continents)
                            {
                                <option value="@c.Name">@c.Name@(c.Tiles > 0 ? null : " (no tiles)")</option>
                            }
                        </select>
                    </div>
                    <div class="pa-field">
                        <span class="pa-label">Search</span>
                        <div class="pa-segmented" role="group" aria-label="How far each replanned leg's search looks">
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(search == RouteSearch.Band)" @onclick="() => SetSearch(RouteSearch.Band)"
                                    title="The bot's own search: a band around the straight line. Fast; a leg that must stray far from the line stops short.">
                                Band
                            </button>
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(search == RouteSearch.Continent)" @onclick="() => SetSearch(RouteSearch.Continent)"
                                    title="Finds the way across the whole continent first, then searches along it. For long legs.">
                                Continent
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pa-row">
                    <div class="pa-field">
                        <span class="pa-label">New legs</span>
                        <div class="pa-segmented" role="group" aria-label="How a new leg is walked">
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(editor.NewLegs == LegKind.Replanned)" @onclick="() => editor.NewLegs = LegKind.Replanned"
                                    title="Replanned: the navmesh's way between the nodes, which the bot finds again as it walks. What is drawn is the replanned result.">
                                Replanned
                            </button>
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(editor.NewLegs == LegKind.Exact)" @onclick="() => editor.NewLegs = LegKind.Exact"
                                    title="Exact: the line as drawn, walked as it is (the bot passes a point every 10 yards along it).">
                                Exact
                            </button>
                        </div>
                    </div>
                    <div class="pa-field">
                        <span class="pa-label">Cost zones</span>
                        <div class="pa-segmented" role="group" aria-label="Whether the legs are planned with the cost zones">
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(Design.CostZones == CostZoneUse.Apply)" @onclick="() => SetCostZones(CostZoneUse.Apply)"
                                    title="Plan with the authored roads and danger zones. A Forever route saved so applies them on its run; the Classic bot always does.">
                                Apply
                            </button>
                            <button class="pa-toggle" type="button" aria-pressed="@Aria.State(Design.CostZones == CostZoneUse.Ignore)" @onclick="() => SetCostZones(CostZoneUse.Ignore)"
                                    title="Plan as if no road or danger zone were authored, as a Forever run walks unless its route applies them.">
                                Ignore
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pa-row pa-route-options">
                    <label class="pa-check" title="Back from the last node to the first, and round again: a Forever route repeats">
                        <input type="checkbox" checked="@Design.Loop" @onchange="e => Edit(() => editor.SetLoop(e.Value is true))" /> Loop
                    </label>
                    <label class="pa-check" title="Each leg's other kind, faintly: the replanned way beside an exact line, the line beside a replanned way">
                        <input type="checkbox" checked="@compare" @onchange="e => SetCompare(e.Value is true)" /> Compare
                    </label>
                    <span class="pa-spacer"></span>
                    <button class="pa-btn pa-btn--ghost" type="button" disabled="@(!editor.CanUndo)" title="Undo the last edit (Ctrl+Z)" @onclick="Undo">
                        <span class="oi oi-action-undo" aria-hidden="true"></span> Undo
                    </button>
                    <button class="pa-btn pa-btn--ghost" type="button" disabled="@(!editor.CanRedo)" title="Redo what was undone (Ctrl+Y)" @onclick="Redo">
                        <span class="oi oi-action-redo" aria-hidden="true"></span> Redo
                    </button>
                </div>

                <p class="pa-tip">@Tip</p>

                <div class="pa-field">
                    <label class="pa-label" for="pa-route-place">Add a place</label>
                    <div class="pa-input-group">
                        <input class="pa-input" id="pa-route-place" list="pa-route-places" autocomplete="off"
                               placeholder="A town, a flight master..." @bind="place" @bind:event="oninput" />
                        <button class="pa-btn pa-btn--icon" type="button" disabled="@(Place is null)" title="Add it as the last node" @onclick="AddPlace">
                            <span class="oi oi-plus" aria-hidden="true"></span>
                        </button>
                    </div>
                    <datalist id="pa-route-places">
                        @foreach (NamedLocation location in Places)
                        {
                            <option value="@location.Name"></option>
                        }
                    </datalist>
                </div>

                <div class="pa-route-summary">
                    <ResultLine Text="@summary" Kind="@summaryKind" />
                    @if (stats.Legs > 0)
                    {
                        <span class="pa-faint">
                            @Words.Yards(stats.Yards) · @Words.Duration(stats.Running) at a run@(stats.Climb >= 1 ? $" · climbs {Words.Yards(stats.Climb)}" : null) · @Words.Count(nodes.Length, "node")
                        </span>
                    }
                </div>

                @if (nodes.Length > 0)
                {
                    <ol class="pa-waypoints" aria-label="Nodes">
                        @for (int i = 0; i < nodes.Length; i++)
                        {
                            int index = i;
                            RouteNode node = nodes[index];
                            // The legs are in node order, the one back to the first last: node i's leg is planned[i].
                            DesignLeg? leg = index < planned.Length ? planned[index] : null;
                            <li class="pa-waypoint @(index == selectedNode ? "is-selected" : null)">
                                <span class="pa-waypoint-n">@(index + 1)</span>
                                <button class="pa-node-kind pa-node-kind--@KindClass(node.Kind)" type="button" title="@KindTitle(node)" @onclick="() => SelectNode(index)">@KindLetter(node.Kind)</button>
                                <button class="pa-waypoint-at" type="button" title="Show it on the map" @onclick="() => FocusAsync(index)">@Describe(node)</button>
                                @if (leg is not null)
                                {
                                    <button class="pa-leg-kind" type="button" title="@LegTitle(leg) - click to walk it @(leg.Kind == LegKind.Exact ? "replanned" : "exactly")"
                                            @onclick="() => ToggleLeg(index)">
                                        <span class="pa-dot pa-dot--@LegDot(leg)" aria-hidden="true"></span>
                                        @(leg.Kind == LegKind.Exact ? "exact" : "replanned")
                                        @(leg.Yards > 0 ? Words.Yards(leg.Yards) : null)
                                    </button>
                                }
                                <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Remove node @(index + 1)" @onclick="() => Remove(index)">
                                    <span class="oi oi-x" aria-hidden="true"></span>
                                </button>
                            </li>
                            @if (index == selectedNode)
                            {
                                <li class="pa-node-inspector">
                                    @if (node.Kind == NodeKind.Area)
                                    {
                                        <label class="pa-label" for="pa-node-kills">Roamed until this many kills</label>
                                        <input class="pa-input" id="pa-node-kills" type="number" min="1" value="@node.Kills"
                                               @onchange="e => SetKills(index, e.Value)" />
                                    }
                                    else
                                    {
                                        <div class="pa-segmented" role="group" aria-label="What node @(index + 1) asks of the route">
                                            @foreach (NodeKind kind in PointKinds)
                                            {
                                                <button class="pa-toggle" type="button" aria-pressed="@Aria.State(node.Kind == kind)" title="@KindHelp(kind)"
                                                        @onclick="() => SetKind(index, kind)">
                                                    @kind
                                                </button>
                                            }
                                        </div>
                                        @if (node.Kind == NodeKind.Stop)
                                        {
                                            @if (node.Stop is { QuestStart: not null } or { QuestEnd: not null })
                                            {
                                                <span class="pa-faint">Visits @node.Stop, whoever or whatever is there; or an NPC or a role instead:</span>
                                            }
                                            <div class="pa-row">
                                                <input class="pa-input pa-grow" placeholder="The NPC's name" aria-label="The NPC visited" value="@node.Stop?.Npc"
                                                       @onchange="e => SetStop(index, new StopTarget(Npc: Text(e.Value)))" />
                                                <select class="pa-select" aria-label="Or the nearest NPC with a role" value="@(node.Stop?.Npc is null ? node.Stop?.Role : null)"
                                                        @onchange="e => SetStop(index, new StopTarget(Role: Text(e.Value)))">
                                                    <option value="">or the nearest...</option>
                                                    @foreach (string role in world.World.NpcFlags.Keys.Order())
                                                    {
                                                        <option value="@role">@role</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    }
                                    <div class="pa-actions">
                                        <button class="pa-btn" type="button" disabled="@(index == 0)" @onclick="() => MoveNode(index, -1)" title="Visit it one node earlier">
                                            <span class="oi oi-arrow-top" aria-hidden="true"></span> Earlier
                                        </button>
                                        <button class="pa-btn" type="button" disabled="@(index == nodes.Length - 1)" @onclick="() => MoveNode(index, 1)" title="Visit it one node later">
                                            <span class="oi oi-arrow-bottom" aria-hidden="true"></span> Later
                                        </button>
                                    </div>
                                </li>
                            }
                        }
                    </ol>

                    <div class="pa-actions pa-actions--wrap">
                        <button class="pa-btn" type="button" disabled="@(nodes.Length < 2)" title="Walk the route the other way" @onclick="() => Edit(editor.Reverse)">
                            <span class="oi oi-loop-circular" aria-hidden="true"></span> Reverse
                        </button>
                        <button class="pa-btn" type="button" disabled="@(nodes.Length < 3)" title="Keep every other shape node; the others, the first and the last stay" @onclick="() => Edit(editor.Halve)">Halve</button>
                        <button class="pa-btn" type="button" disabled="@(nodes.Length < 2)" title="Add a shape node halfway along each leg" @onclick="() => Edit(editor.Double)">Double</button>
                        <button class="pa-btn" type="button" disabled="@(nodes.Length < 2)" title="Walk every leg @(editor.NewLegs == LegKind.Exact ? "exactly as drawn" : "replanned on the navmesh"), as the new ones"
                                @onclick="() => Edit(() => editor.SetLegs(editor.NewLegs))">
                            All @(editor.NewLegs == LegKind.Exact ? "exact" : "replanned")
                        </button>
                        <button class="pa-btn pa-btn--ghost" type="button" title="Remove every node (it can be undone)" @onclick="() => Edit(editor.Clear)">Clear</button>
                    </div>
                }

                <RouteLibrary World="@world" Design="@Design" Opened="@opened" Dirty="@editor.Dirty" OnOpened="Opened" OnSaved="Saved" />
                <ForeverLibrary World="@world" Continent="@continent" Design="@Design" Dirty="@editor.Dirty" Open="@ForeverRoute" OnOpened="OpenedForever" />
            </div>
        }
    </Panel>

    <Panel Title="Layers" Icon="layers" Position="bottom-right" Class="pa-panel--layers" Collapsed="true">
        <WorldLayers @ref="layers" Id="pa-route-layers" World="@world" Continent="@(continent.Length == 0 ? null : continent)"
                     OnChanged="() => Show()" OnFocus="CenterAsync" OnWaypoint="AddWaypoint" WaypointTitle="Add it to the route as a node" />
    </Panel>
</WorldModeView>

@if (!status.Online)
{
    <OfflineNotice Service="@status.Service" Reason="@status.Error" />
}

@code {
    /// <summary>A Forever route file to open as nodes: <c>/world?mode=route&amp;forever=my_route.json</c>.</summary>
    [SupplyParameterFromQuery(Name = "forever")] public string? ForeverRoute { get; set; }

    /// <summary>The nodes' shape on the map.</summary>
    public const string NodesId = "nodes";

    /// <summary>An area node's shape on the map: this, then the node's index.</summary>
    public const string AreaPrefix = "area-";

    /// <summary>A node's kind marker on the map: this, then the node's index.</summary>
    public const string NodePrefix = "node-";

    /// <summary>While answers arrive, the map is drawn again at most this often.</summary>
    private const int RedrawMs = 150;

    private static readonly WorldTool[] Tools =
    [
        new(WorldShapes.Point, "Add nodes: each click adds one at the end, and one on an NPC or a quest giver visits it; Esc stops", "Nodes"),
        new(WorldShapes.Path, "Draw a path: press and drag along the way; it is walked as drawn", "Path"),
        new(WorldShapes.Polygon, "Draw an area to roam: click its corners, then the first again (or Enter); Esc cancels", "Area"),
        new(WorldShapes.Rectangle, "Draw a rectangular area to roam: click two opposite corners", "Box area"),
    ];

    // What a point node may be; an area is drawn as one.
    private static readonly NodeKind[] PointKinds = [NodeKind.Shape, NodeKind.Required, NodeKind.Stop];

    private RouteEditor editor = new();
    private RouteLegs legs = null!;
    private CancellationTokenSource plans = new();
    private DotNetObjectReference<RouteMap>? self;
    private ElementReference undoAnchor;
    // Each leg as it is walked, as the map was last drawn: the panel lists the same.
    private DesignLeg[] planned = [];
    private readonly string undoToken = Guid.NewGuid().ToString("N");
    private WorldModeView? view;
    private WorldLayers? layers;
    private WorldSnapshot? world;
    private string continent = string.Empty;
    private WorldScene scene = WorldScene.Empty(string.Empty);
    private string? tool;
    private string? selectedShape = NodesId;
    private int selectedNode = -1;
    private RouteSearch search = RouteSearch.Band;
    private bool compare;
    private bool redrawQueued;
    private string? opened;
    private string place = string.Empty;

    private RouteDesign Design => editor.Design;

    private IEnumerable<NamedLocation> Places => world?.LocationsOn(continent) ?? [];

    private NamedLocation? Place => Places.FirstOrDefault(p => p.Name == place.Trim());

    private int MapId => world?.Continent(continent)?.MapId ?? -1;

    private string Tip => tool switch
    {
        WorldShapes.Point => "Click the map to add nodes at the end; on an NPC or a quest giver, the node visits it. Esc stops.",
        WorldShapes.Path => "Press and drag along the way to draw a path, walked as drawn; one that starts by the last node carries on from it.",
        WorldShapes.Polygon => "Click the area's corners, then the first one again (or Enter). Backspace takes a corner back; Esc cancels.",
        WorldShapes.Rectangle => "Click two opposite corners of the area. Esc cancels.",
        _ when Design.Nodes.Length == 0 => "Turn on Nodes or Path (top right) and click or draw on the map, add a place, or open a path from the library.",
        _ => "Drag a node to move it, or the small dot between two to insert one; right-click one to remove it. Click a node's letter for its kind.",
    };

    protected override async Task OnInitializedAsync()
    {
        legs = new RouteLegs((request, token) => pathing.FindRouteAsync(request, token), Answered);
        OnDispose(() =>
        {
            plans.Cancel();
            plans.Dispose();
        });
        Subscribe(() => status.Changed += Redraw, () => status.Changed -= Redraw);
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            self = DotNetObjectReference.Create(this);
            await js.InvokeVoidAsync("pathingUi.watchUndo", Token, self, undoToken, undoAnchor);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // The buttons still undo and redo.
        }
    }

    /// <summary>Ctrl+Z or Ctrl+Y on the page, outside a text box.</summary>
    [JSInvokable]
    public void OnUndoKey(bool redo)
    {
        if (redo)
        {
            Redo();
        }
        else
        {
            Undo();
        }

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        world = status.Online ? await worldCache.GetAsync() : null;
        if (world is null)
        {
            return;
        }

        // A route not begun yet is planned as the client's bot plans with nothing chosen.
        if (Design.Nodes.Length == 0 && !editor.CanUndo)
        {
            editor = new RouteEditor(RouteDesign.For(world.World.Client)) { NewLegs = editor.NewLegs };
        }

        if (world.Continent(continent) is null)
        {
            continent = world.World.Continents.FirstOrDefault(c => c.Tiles > 0)?.Name ?? world.World.Continents.FirstOrDefault()?.Name ?? string.Empty;
        }

        Plan();
        Show();
    }

    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    // --- the route ----------------------------------------------------------------------------

    // Asks for every leg not planned yet (the exact ones too, to compare); each answer redraws the map.
    private void Plan()
    {
        if (world is null || world.Continent(continent) is not ContinentInfo info)
        {
            return;
        }

        WorldSnapshot snapshot = world;
        legs.Plan(Design, search, at => snapshot.ZoneAt(info.MapId, at)?.UiMapId ?? 0, plans.Token, exact: compare);
    }

    // An answer arrived: the map is drawn again shortly, once for every answer that arrives meanwhile.
    private void Answered()
    {
        _ = InvokeAsync(async () =>
        {
            if (redrawQueued)
            {
                return;
            }

            redrawQueued = true;
            try
            {
                await Task.Delay(RedrawMs, Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            redrawQueued = false;
            TakeHeights();
            Show();
            StateHasChanged();
        });
    }

    // A node placed with no height takes the ground's from a way planned from it, else to it.
    private void TakeHeights()
    {
        DesignLeg[] answered = legs.Of(Design, search);
        editor.TakeHeights(i =>
            i < answered.Length && answered[i].Planned.Points.Length > 0 ? answered[i].Planned.Points[0].Z
            : answered.FirstOrDefault(l => l.To == i && l.Planned.Found)?.Planned.Points[^1].Z ?? 0);
    }

    // An edit made: planned, the zones learned, drawn.
    private void Edit(Action edit)
    {
        edit();
        selectedNode = selectedNode < Design.Nodes.Length ? selectedNode : -1;
        Changed();
    }

    private void Changed()
    {
        Plan();
        LearnZones();
        Show();
    }

    private void Undo()
    {
        if (editor.Undo())
        {
            Edit(() => { });
        }
    }

    private void Redo()
    {
        if (editor.Redo())
        {
            Edit(() => { });
        }
    }

    // The nodes' zones from the service's area grid; the list names them again when they are known.
    private void LearnZones()
    {
        if (world is null || Design.Nodes.Length == 0)
        {
            return;
        }

        int mapId = MapId;
        Point3[] points = [.. Design.Nodes.Select(n => n.At)];
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (await zoneLookup.LearnAsync(mapId, points, Token))
                {
                    StateHasChanged();
                }
            }
            catch (OperationCanceledException)
            {
                // The page went away.
            }
        });
    }

    // Each leg as it is walked - a replanned one as far as it goes, coloured by how it ended, an exact
    // one as its line - and with Compare the other kind faintly; the nodes, their kinds and the areas.
    private void Show(bool frame = false)
    {
        planned = legs.Of(Design, search);
        List<WorldRoute> routes = [];
        List<WorldMarker> markers = [.. layers?.Markers ?? []];
        foreach (DesignLeg leg in planned)
        {
            string id = $"leg-{leg.From}";
            string name = $"Leg {leg.From + 1} to {leg.To + 1}";
            if (leg.Kind == LegKind.Exact)
            {
                routes.Add(WorldRoute.Of(id, WorldKinds.Exact, leg.Way, $"{name}: exact, {Words.Yards(leg.Yards)}"));
                if (compare && leg.Planned.Points.Length > 0)
                {
                    routes.Add(WorldRoute.Of($"{id}-replanned", WorldKinds.Recent, leg.Planned.Points, $"{name} replanned: {Words.Yards(leg.Planned.Length)}"));
                }
            }
            else
            {
                routes.AddRange(RouteDrawing.Of(id, name, leg.Planned.Status, leg.Planned.Points, leg.Start, leg.End, leg.Planned.Detail, markers));
                if (compare)
                {
                    routes.Add(WorldRoute.Of($"{id}-exact", WorldKinds.Recent, [leg.Start, leg.End],
                        $"{name} as drawn: {Words.Yards(RouteGeometry.Distance(leg.Start, leg.End))}"));
                }
            }
        }

        List<WorldShape> shapes = [];
        RouteNode[] nodes = Design.Nodes;
        for (int i = 0; i < nodes.Length; i++)
        {
            RouteNode node = nodes[i];
            string at = i.ToString(CultureInfo.InvariantCulture);
            if (node is { Kind: NodeKind.Area, Area: { Length: >= 2 } corners })
            {
                shapes.Add(WorldShape.Of(AreaPrefix + at, corners.Length == 2 ? WorldShapes.Rectangle : WorldShapes.Polygon, WorldKinds.Area, corners,
                    editable: true, label: $"Node {i + 1}: roam"));
            }
            else if (node.Kind is NodeKind.Required or NodeKind.Stop)
            {
                markers.Add(WorldMarker.At(NodePrefix + at, node.Kind == NodeKind.Stop ? WorldKinds.NodeStop : WorldKinds.NodeRequired, node.At,
                    node.Kind == NodeKind.Stop ? $"Visit {node.Stop}" : null, KindTitle(node)));
            }
        }

        if (nodes.Length > 0)
        {
            shapes.Add(WorldShape.Of(NodesId, WorldShapes.Points, WorldKinds.Waypoints, nodes.Select(n => n.At), editable: true));
        }

        scene = new WorldScene(continent, [.. routes], [.. markers], ZoneLabels.Of(world, continent), frame, [.. shapes], selectedShape);
    }

    private (string Text, ResultKind Kind) Summary(DesignLeg[] planned, RouteStats stats)
    {
        int replanned = planned.Count(l => l.Kind == LegKind.Replanned);
        return stats.Legs == 0 ? (Design.Nodes.Length == 0 ? "No nodes yet" : "Add another node for the first leg", ResultKind.Info)
            : stats.Pending > 0 ? ($"Planning {stats.Pending} of {Words.Count(replanned, "replanned leg")}...", ResultKind.Info)
            : stats.Failed > 0 ? ($"{stats.Failed} of {Words.Count(replanned, "replanned leg")} found no way", ResultKind.Error)
            : stats.Partial > 0 ? ($"{stats.Partial} of {Words.Count(replanned, "replanned leg")} stop short", ResultKind.Warn)
            : replanned == stats.Legs ? (stats.Legs == 1 ? "Route found" : $"All {stats.Legs} legs found", ResultKind.Ok)
            : ($"{Words.Count(stats.Legs, "leg")}: {replanned} replanned, {stats.Legs - replanned} exact", ResultKind.Ok);
    }

    private static string LegDot(DesignLeg leg)
    {
        return leg.Kind == LegKind.Exact ? "exact" : leg.Planned.Found ? "ok" : leg.Planned.Partial ? "warn" : leg.Planned.Failed ? "error" : "busy";
    }

    private static string LegTitle(DesignLeg leg)
    {
        string name = $"Leg {leg.From + 1} to {leg.To + 1}";
        return leg.Kind == LegKind.Exact ? $"{name}: exact, walked as drawn"
            : leg.Planned.Status is null ? $"{name}: planning"
            : leg.Planned.Found ? $"{name}: replanned, found in {leg.Planned.ElapsedMs:F0} ms"
            : $"{name}: {leg.Planned.Detail ?? leg.Planned.Status.ToString()}";
    }

    private static string KindLetter(NodeKind kind)
    {
        return kind switch
        {
            NodeKind.Required => "R",
            NodeKind.Stop => "V",
            NodeKind.Area => "A",
            _ => "S",
        };
    }

    private static string KindClass(NodeKind kind)
    {
        return kind.ToString().ToLowerInvariant();
    }

    private static string KindHelp(NodeKind kind)
    {
        return kind switch
        {
            NodeKind.Required => "Required: the route passes it, whatever prices the legs; a Forever route's To",
            NodeKind.Stop => "Stop: the bot visits someone here - an NPC by name, the nearest with a role, a quest's giver",
            _ => "Shape: bends the route the way it was drawn; a stuck bot passes it by (a Forever route's Via)",
        };
    }

    private static string KindTitle(RouteNode node)
    {
        return node.Kind switch
        {
            NodeKind.Stop => $"A stop: visits {node.Stop}",
            NodeKind.Area => $"An area, roamed until {Words.Count(node.Kills, "kill")}",
            _ => KindHelp(node.Kind),
        };
    }

    // A node as a player reads it: its zone and map coordinates, and who a stop visits.
    private string Describe(RouteNode node)
    {
        string where = ZoneLabels.Where(world is null ? null : zoneLookup.Known(world, MapId, node.At), node.At);
        return node.Kind == NodeKind.Stop ? $"{node.Stop} · {where}" : where;
    }

    private static string? Text(object? value)
    {
        return value?.ToString() is { Length: > 0 } text && !string.IsNullOrWhiteSpace(text) ? text.Trim() : null;
    }

    // --- the map's events -----------------------------------------------------------------------

    private void Drawn(WorldDrawn drawn)
    {
        switch (drawn.Shape)
        {
            case WorldShapes.Point:
                // On an NPC, a stop that visits it; on another marker, a node right on it.
                WorldLayers.LayerPlace? on = drawn.Marker is string marker ? layers?.PlaceOf(marker) : null;
                editor.Add(on?.At ?? drawn.Points[0], on?.Stop is null ? NodeKind.Shape : NodeKind.Stop, on?.Stop);
                selectedShape = NodesId;
                break;
            case WorldShapes.Path:
                editor.AddPath(drawn.Points);
                selectedShape = NodesId;
                break;
            default:
                // One area at a time: the tool goes when it is drawn.
                editor.AddArea(drawn.Points);
                int added = Array.FindIndex(Design.Nodes, n => ReferenceEquals(n.Area, drawn.Points));
                selectedShape = AreaPrefix + added.ToString(CultureInfo.InvariantCulture);
                tool = null;
                break;
        }

        Edit(() => { });
    }

    private void Edited(WorldEdited edited)
    {
        if (edited.Id == NodesId)
        {
            Edit(() => editor.Reshape(edited.Points));
        }
        else if (AreaIndex(edited.Id) is int index)
        {
            Edit(() => editor.SetArea(index, edited.Points));
        }
    }

    private void ShapeSelected(string? id)
    {
        selectedShape = id ?? NodesId;
        if (AreaIndex(id) is int index)
        {
            selectedNode = index;
        }

        Show();
    }

    // A node's kind marker selects it; another marker is the layers'.
    private async Task MarkerClickedAsync(string id)
    {
        if (id.StartsWith(NodePrefix, StringComparison.Ordinal) &&
            int.TryParse(id[NodePrefix.Length..], NumberStyles.Integer, CultureInfo.InvariantCulture, out int index) && index < Design.Nodes.Length)
        {
            SelectNode(index);
            return;
        }

        if (layers is not null)
        {
            await layers.MarkerClickedAsync(id);
        }
    }

    private int? AreaIndex(string? id)
    {
        return id is not null && id.StartsWith(AreaPrefix, StringComparison.Ordinal) &&
               int.TryParse(id[AreaPrefix.Length..], NumberStyles.Integer, CultureInfo.InvariantCulture, out int index) &&
               index < Design.Nodes.Length && Design.Nodes[index].Kind == NodeKind.Area
            ? index
            : null;
    }

    // --- the layers ---------------------------------------------------------------------------

    // A place of the layers' quest, as the last node.
    private void AddWaypoint(Point3 at)
    {
        selectedShape = NodesId;
        Edit(() => editor.Add(at));
    }

    private async Task CenterAsync(Point3 at)
    {
        if (view is not null)
        {
            await view.CenterOnAsync(at);
        }
    }

    // --- the panel ----------------------------------------------------------------------------

    private void ChangeContinent(ChangeEventArgs e)
    {
        continent = e.Value?.ToString() ?? string.Empty;
        Reset();
        Show();
    }

    private void SetSearch(RouteSearch value)
    {
        if (search != value)
        {
            search = value;
            Plan();
            Show();
        }
    }

    private void SetCostZones(CostZoneUse use)
    {
        Edit(() => editor.SetCostZones(use));
    }

    private void SetCompare(bool on)
    {
        compare = on;
        Plan();
        Show();
    }

    private void AddPlace()
    {
        if (Place is NamedLocation location)
        {
            place = string.Empty;
            selectedShape = NodesId;
            Edit(() => editor.Add(location.Position));
        }
    }

    private void SelectNode(int index)
    {
        selectedNode = selectedNode == index ? -1 : index;
        selectedShape = Design.Nodes[index].Kind == NodeKind.Area ? AreaPrefix + index.ToString(CultureInfo.InvariantCulture) : NodesId;
        Show();
    }

    private async Task FocusAsync(int index)
    {
        selectedShape = NodesId;
        Show();
        if (view is not null)
        {
            await view.CenterOnAsync(Design.Nodes[index].At);
        }
    }

    private void SetKind(int index, NodeKind kind)
    {
        RouteNode node = Design.Nodes[index];
        Edit(() => editor.Set(index, node with { Kind = kind, Stop = kind == NodeKind.Stop ? node.Stop ?? new StopTarget() : null }));
    }

    private void SetStop(int index, StopTarget stop)
    {
        Edit(() => editor.Set(index, Design.Nodes[index] with { Stop = stop }));
    }

    private void SetKills(int index, object? value)
    {
        if (int.TryParse(value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int kills) && kills >= 1)
        {
            Edit(() => editor.Set(index, Design.Nodes[index] with { Kills = kills }));
        }
    }

    private void ToggleLeg(int index)
    {
        RouteNode node = Design.Nodes[index];
        Edit(() => editor.Set(index, node with { Leg = node.Leg == LegKind.Exact ? LegKind.Replanned : LegKind.Exact }));
    }

    private void MoveNode(int index, int by)
    {
        selectedNode = index + by;
        Edit(() => editor.Move(index, by));
    }

    private void Remove(int index)
    {
        selectedNode = selectedNode == index ? -1 : selectedNode > index ? selectedNode - 1 : selectedNode;
        Edit(() => editor.Remove(index));
    }

    // Nothing designed, and no leg kept: answers on their way are dropped. A new continent is a new route.
    private void Reset()
    {
        plans.Cancel();
        plans.Dispose();
        plans = new CancellationTokenSource();
        legs.Clear();
        editor = new RouteEditor(RouteDesign.Empty with { CostZones = Design.CostZones }) { NewLegs = editor.NewLegs };
        selectedShape = NodesId;
        selectedNode = -1;
        tool = null;
        opened = null;
    }

    // --- the library --------------------------------------------------------------------------

    // A recorded path replaces the route, on its zone's continent, as nodes with legs of the new kind.
    private void Opened(RouteLibrary.OpenedPath path)
    {
        string? other = world?.Continent(path.Zone.Continent)?.Name;
        if (other is not null && other != continent)
        {
            continent = other;
            Reset();
        }

        editor.Open(Design with { Nodes = [.. path.Waypoints.Select(w => new RouteNode(w, Leg: editor.NewLegs))], Loop = false });
        opened = path.Name;
        selectedNode = -1;
        Plan();
        LearnZones();
        Show(frame: true);
    }

    // Saved as a recorded path; the design counts as saved only where the file holds all of it.
    private void Saved(string name)
    {
        opened = name;
        if (RecordedPaths.Holds(Design))
        {
            editor.MarkSaved();
        }
    }

    // A Forever route file replaces the route, on its continent.
    private void OpenedForever(ForeverLibrary.OpenedRoute route)
    {
        if (route.Continent != continent)
        {
            continent = route.Continent;
            Reset();
        }

        editor.Open(route.Design);
        opened = null;
        selectedNode = -1;
        Plan();
        LearnZones();
        Show(frame: true);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await js.InvokeTeardownAsync("pathingUi.unwatchUndo", undoToken);
        self?.Dispose();
    }
}
