@page "/npc-routes"

@inherits ControlCenterComponent

@inject IPathingClient pathing
@inject WorldCache worldCache
@inject PathingStatus status
@inject ZoneLookup zoneLookup

<PageTitle>NPC routes · Control Center</PageTitle>

@* Routes to an NPC, as a bot walks to a vendor or a trainer: every NPC of a type in a zone is a
   marker on the world view, one is chosen in the list or by clicking it, the start is picked on the
   map or rolled at random, and the route is drawn in its status colour. *@

<WorldView Scene="@scene" Picking="@picking" OnPick="PickedAsync" OnMarker="MarkerClicked">
    <Panel Title="NPC routes" Icon="people" Position="top-left">
        <div class="pa-form">
            <div class="pa-field">
                <label class="pa-label" for="pa-npc-zone">Zone</label>
                <select class="pa-select" id="pa-npc-zone" value="@uiMap" @onchange="ZoneChosenAsync">
                    <option value="0" disabled>Choose a zone</option>
                    @foreach (IGrouping<string, ZoneInfo> group in zones.GroupBy(z => z.Continent))
                    {
                        <optgroup label="@group.Key">
                            @foreach (ZoneInfo zone in group)
                            {
                                <option value="@zone.UiMapId">@zone.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            <div class="pa-row">
                <div class="pa-field">
                    <label class="pa-label" for="pa-npc-type">Type</label>
                    <select class="pa-select" id="pa-npc-type" value="@type" @onchange="TypeChosenAsync">
                        @foreach (string flag in types)
                        {
                            <option value="@flag">@flag</option>
                        }
                    </select>
                </div>
                <div class="pa-field pa-grow2">
                    <label class="pa-label" for="pa-npc-name">NPC</label>
                    <select class="pa-select" id="pa-npc-name" @bind="npcEntry" @bind:after="NpcChosen" disabled="@(npcs.Length == 0)">
                        @if (npcs.Length == 0)
                        {
                            <option value="0">@(uiMap == 0 ? "Choose a zone first" : loading ? "Loading..." : "None in this zone")</option>
                        }
                        @foreach (NpcInfo npc in npcs)
                        {
                            <option value="@npc.Entry">@npc.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="pa-field">
                <span class="pa-label">Start</span>
                <div class="pa-input-group">
                    <span class="pa-input pa-readout">@StartText</span>
                    <button class="pa-btn pa-btn--icon @(picking ? "pa-btn--primary" : null)" type="button" disabled="@(uiMap == 0)"
                            title="@(picking ? "Click the map to start there, or click here to stop" : "Pick the start on the map")" @onclick="() => picking = !picking">
                        <span class="oi oi-map-marker" aria-hidden="true"></span>
                    </button>
                    <button class="pa-btn pa-btn--icon" type="button" disabled="@(uiMap == 0)" title="A random point in the zone" @onclick="RandomStartAsync">
                        <span class="oi oi-random" aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <label class="pa-check"><input type="checkbox" @bind="reversed" @bind:after="() => Draw()" /> From the NPC back to the start</label>

            <BusyButton Class="pa-btn--primary" Icon="media-play" Busy="@busy" Disabled="@(!Ready)" OnClick="FindAsync">
                Find route
            </BusyButton>

            <ResultLine Text="@result" Kind="@resultKind" />
            <span class="pa-faint">Click an NPC on the map to choose it.</span>
        </div>
    </Panel>
</WorldView>

@if (!status.Online)
{
    <OfflineNotice Service="@status.Service" Reason="@status.Error" />
}

@code {
    // Random starts stay this far inside the zone's map, where most zones have ground.
    private const float MapMargin = 20f;
    private const float MapSpan = 70f;

    // Random points tried before taking one the area grid does not put in the zone.
    private const int MaxThrows = 8;

    public const string DefaultType = "vendor";

    private const string NpcPrefix = "npc-";

    private WorldSnapshot? world;
    private ZoneInfo[] zones = [];
    private string[] types = [];
    private NpcInfo[] npcs = [];

    private int uiMap;
    private string type = DefaultType;
    private int npcEntry;
    private Point3? start;
    private bool reversed;
    private bool picking;
    private bool loading;
    private bool busy;
    // Bumped by every zone or type chosen: a list asked for an earlier one comes back too late.
    private int listing;
    private string? result;
    private ResultKind resultKind;
    private RouteResponse? route;
    private WorldScene scene = WorldScene.Empty(string.Empty);

    private ZoneInfo? Zone => zones.FirstOrDefault(z => z.UiMapId == uiMap);

    private NpcInfo? Npc => npcs.FirstOrDefault(n => n.Entry == npcEntry);

    private bool Ready => Endpoints() is not null;

    private string StartText => start is Point3 s && world is not null
        ? ZoneLabels.Where(zoneLookup.Known(world, Zone?.MapId ?? -1, s), s)
        : "Pick a point or roll one";

    protected override async Task OnInitializedAsync()
    {
        Subscribe(() => status.Changed += Redraw, () => status.Changed -= Redraw);
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        world = await worldCache.GetAsync();
        // Zones only: a continent's or the world's map holds no NPC list of its own.
        zones = world is null
            ? []
            : [.. world.World.Zones.Where(z => z.AreaId != 0 && world.CanRoute(z.Continent)).OrderBy(z => z.Continent).ThenBy(z => z.Name)];
        types = world is null ? [] : [.. world.World.NpcFlags.Keys.Order(StringComparer.Ordinal)];
        Draw();
    }

    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task ZoneChosenAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int chosen))
        {
            return;
        }

        uiMap = chosen;
        start = null;
        route = null;
        await ListNpcsAsync();
        Draw(frame: true);
    }

    private async Task TypeChosenAsync(ChangeEventArgs e)
    {
        type = e.Value?.ToString() ?? DefaultType;
        route = null;
        await ListNpcsAsync();
        Draw(frame: true);
    }

    // Blazor runs the next event while a handler awaits, so two quick changes overlap: only the list
    // asked for last is taken, whichever answer comes back first.
    private async Task ListNpcsAsync()
    {
        int mine = ++listing;
        npcs = [];
        npcEntry = 0;
        loading = uiMap != 0;
        if (uiMap == 0)
        {
            return;
        }

        try
        {
            ServiceResult<NpcInfo[]> listed = await pathing.GetNpcsAsync(uiMap, type, Token);
            if (mine != listing)
            {
                return;
            }

            npcs = listed.Value ?? [];
            npcEntry = npcs.Length > 0 ? npcs[0].Entry : 0;
            Say(listed.Ok ? null : listed.Error, ResultKind.Error);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (mine == listing)
            {
                loading = false;
            }
        }
    }

    private void NpcChosen()
    {
        route = null;
        Draw();
    }

    private void MarkerClicked(string id)
    {
        if (id.StartsWith(NpcPrefix, StringComparison.Ordinal) &&
            int.TryParse(id[NpcPrefix.Length..], NumberStyles.Integer, CultureInfo.InvariantCulture, out int entry))
        {
            npcEntry = entry;
            NpcChosen();
        }
    }

    private async Task PickedAsync(WorldPoint point)
    {
        start = point.ToPoint3();
        picking = false;
        route = null;
        Draw();
        if (Zone is ZoneInfo zone)
        {
            try
            {
                await zoneLookup.LearnAsync(zone.MapId, [start.Value], Token);
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    // A random point on the zone's map that the area grid puts in the zone, on the ground: a zone's
    // map holds parts of its neighbours and the sea, so a few throws may miss.
    private async Task RandomStartAsync()
    {
        if (Zone is not ZoneInfo zone)
        {
            return;
        }

        try
        {
            Point3 rolled = default;
            for (int throws = 1; throws <= MaxThrows; throws++)
            {
                Point3 map = new((Random.Shared.NextSingle() * MapSpan) + MapMargin, (Random.Shared.NextSingle() * MapSpan) + MapMargin, 0);
                Point3 at = ZoneMath.ToWorld(zone, map);
                ServiceResult<AreaAtPoint> area = await pathing.GetAreaAsync(zone.MapId, at.X, at.Y, Token);
                if (uiMap != zone.UiMapId)
                {
                    // Another zone was chosen meanwhile: a start in this one is no longer wanted.
                    return;
                }

                rolled = at with { Z = area.Value?.Z ?? 0 };
                if (area.Value is not AreaAtPoint answer || (answer.UiMapId == zone.UiMapId && answer.Z != 0) || answer.UiMapId == 0)
                {
                    break;
                }
            }

            start = rolled;
            route = null;
            Draw();
            await zoneLookup.LearnAsync(zone.MapId, [rolled], Token);
            Draw();
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Null until the NPC and the start are both known.
    private (Point3 From, Point3 To)? Endpoints()
    {
        if (Npc is not NpcInfo npc || start is not Point3 at)
        {
            return null;
        }

        return reversed ? (npc.Position, at) : (at, npc.Position);
    }

    private async Task FindAsync()
    {
        // Find is enabled only once both ends are known, but a click can be on its way as they change:
        // the server never checks a button's disabled.
        if (Endpoints() is not (Point3 from, Point3 to))
        {
            return;
        }

        int asked = uiMap;
        busy = true;
        Say("Searching...", ResultKind.Info);
        try
        {
            RouteResponse found = await pathing.FindRouteAsync(new RouteRequest(null, asked, CoordinateSpace.World, from, to), Token);
            if (uiMap != asked || Endpoints() != (from, to))
            {
                // The zone, the NPC or the start changed while it was out: the answer is to another question.
                Say(null, ResultKind.Info);
                return;
            }

            route = found;
            (result, resultKind) = RouteResults.Describe(route);
            Draw(frame: true);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private void Say(string? text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }

    // The zone's NPCs of the type, the chosen one named; the start; the route found.
    private void Draw(bool frame = false)
    {
        string continent = Zone?.Continent ?? world?.World.Continents.FirstOrDefault(c => c.Tiles > 0)?.Name ?? string.Empty;
        List<WorldMarker> markers = [];
        foreach (NpcInfo npc in npcs)
        {
            bool chosen = npc.Entry == npcEntry;
            markers.Add(WorldMarker.At($"{NpcPrefix}{npc.Entry.ToString(CultureInfo.InvariantCulture)}", chosen ? WorldKinds.End : WorldKinds.Npc,
                npc.Position, chosen ? npc.Name : null, npc.Name));
        }

        if (start is Point3 from)
        {
            markers.Add(WorldMarker.At("start", WorldKinds.Start, from, "Start"));
        }

        List<WorldRoute> routes = [];
        if (route is not null && Endpoints() is (Point3 a, Point3 b))
        {
            routes.AddRange(RouteDrawing.Of("route", "Route", route.Status, route.Points, a, b, route.Detail, markers));
        }

        scene = new WorldScene(continent, [.. routes], [.. markers], ZoneLabels.Of(world, continent), frame);
    }
}
