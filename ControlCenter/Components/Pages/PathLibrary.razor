@page "/paths"

@inherits ControlCenterComponent

@inject IPathingClient pathing
@inject WorldCache worldCache
@inject PathingStatus status
@inject NavigationManager navigation
@inject IJSRuntime js

<PageTitle>Path library · Control Center</PageTitle>

<Viewport3D>
    <Panel Title="Path library" Icon="map-marker">
        <div class="pa-form">
            <div class="pa-field">
                <label class="pa-label" for="pa-path-file">Recorded path</label>
                <input class="pa-input" id="pa-path-file" list="pa-path-files" autocomplete="off"
                       placeholder="Type to search @paths.Length paths" @bind="name" @bind:after="ChosenAsync" />
                <datalist id="pa-path-files">
                    @foreach (RecordedPathInfo info in paths)
                    {
                        <option value="@info.Name"></option>
                    }
                </datalist>
            </div>

            @if (selected is RecordedPathInfo chosen)
            {
                <span class="pa-faint">
                    @chosen.Bytes.ToString("N0", CultureInfo.InvariantCulture) bytes,
                    saved @chosen.ModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
                </span>
                @if (chosen.Screenshot is string screenshot)
                {
                    <a class="pa-thumb" href="@FileUrl(screenshot)" target="_blank" title="Screenshot saved with the recording">
                        <img src="@FileUrl(screenshot)" alt="Screenshot of @chosen.Name" loading="lazy" />
                    </a>
                }
            }

            <div class="pa-field">
                <label class="pa-label" for="pa-path-zone" title="The zone the points are coordinates of; it also picks the continent">Zone</label>
                <select class="pa-select" id="pa-path-zone" @bind="uiMap">
                    <option value="0" disabled>Choose a zone</option>
                    @foreach (ZoneInfo zone in zones)
                    {
                        <option value="@zone.UiMapId">@zone.Name (@zone.Continent)</option>
                    }
                </select>
            </div>

            <div class="pa-actions">
                <BusyButton Class="pa-btn--primary pa-grow" Icon="eye" Busy="@busy" Disabled="@(selected is null || uiMap == 0)" OnClick="DrawAsync">
                    Load and draw
                </BusyButton>
                <button class="pa-btn" type="button" disabled="@(selected is null)" title="Edit the points" @onclick="Edit">
                    <span class="oi oi-pencil" aria-hidden="true"></span> Edit
                </button>
                <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" disabled="@(selected is null || busy)"
                        title="Delete this path (its screenshot stays)" @onclick="DeleteAsync">
                    <span class="oi oi-trash" aria-hidden="true"></span>
                </button>
            </div>

            @if (points.Length > 1)
            {
                <div class="pa-divider"></div>
                <div class="pa-field">
                    <span class="pa-label">Leg to search (of @points.Length points)</span>
                    <div class="pa-stepper">
                        <button class="pa-btn pa-btn--icon" type="button" title="Previous leg" @onclick="() => Step(-1)">
                            <span class="oi oi-chevron-left" aria-hidden="true"></span>
                        </button>
                        <input class="pa-input" type="number" min="0" max="@(points.Length - 1)" aria-label="Start point" @bind="Start" />
                        <span class="pa-faint">to</span>
                        <input class="pa-input" type="number" min="0" max="@(points.Length - 1)" aria-label="End point" @bind="End" />
                        <button class="pa-btn pa-btn--icon" type="button" title="Next leg" @onclick="() => Step(1)">
                            <span class="oi oi-chevron-right" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>

                <BusyButton Class="pa-btn--primary" Icon="media-play" Busy="@busy" OnClick="SearchLegAsync">
                    Search leg
                </BusyButton>
            }

            <ResultLine Text="@result" Kind="@resultKind" />
        </div>
    </Panel>
</Viewport3D>

@code {
    private RecordedPathInfo[] paths = [];
    private ZoneInfo[] zones = [];

    private string name = string.Empty;
    private RecordedPathInfo? selected;
    private int uiMap;
    private Point3[] points = [];
    private CoordinateSpace space;
    private int start;
    private int end = 1;
    private bool busy;
    private string? result;
    private ResultKind resultKind;

    private int Start
    {
        get => start;
        set => start = Clamp(value);
    }

    private int End
    {
        get => end;
        set => end = Clamp(value);
    }

    private int Clamp(int index) => Math.Clamp(index, 0, Math.Max(0, points.Length - 1));

    protected override async Task OnInitializedAsync()
    {
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        WorldSnapshot? world = await worldCache.GetAsync();
        zones = world?.World.Zones ?? [];

        ServiceResult<RecordedPathInfo[]> listed = await pathing.ListPathsAsync(token: Token);
        paths = listed.Value ?? [];
        if (!listed.Ok)
        {
            Show($"The library is not available: {listed.Error}", ResultKind.Error);
        }
    }

    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private Task ChosenAsync()
    {
        selected = paths.FirstOrDefault(p => p.Name == name);
        points = [];
        Show(null, ResultKind.Info);
        if (selected is not null && ZoneMath.GuessFromName(zones, System.IO.Path.GetFileNameWithoutExtension(selected.Name)) is ZoneInfo zone)
        {
            uiMap = zone.UiMapId;
        }

        return Task.CompletedTask;
    }

    private async Task DrawAsync()
    {
        if (selected is null || uiMap == 0)
        {
            Show("Choose a path and its zone.", ResultKind.Error);
            return;
        }

        busy = true;
        try
        {
            ServiceResult<RecordedPath> read = await pathing.GetPathAsync(selected.Name, Token);
            if (!read.Ok)
            {
                Show(read.Error, ResultKind.Error);
                return;
            }

            // Most recordings are zone map coordinates with no height; the few made with one are world yards.
            points = read.Value.Points;
            space = points.All(p => p.Z == 0) ? CoordinateSpace.Map : CoordinateSpace.World;
            start = 0;
            end = Clamp(1);

            ServiceResult drawn = await pathing.DrawPathAsync(
                new WatchPath(WatchNames.Recorded, uiMap, space, points, WatchColor.Orange), Token);
            Show(drawn.Ok ? $"{points.Length} points ({space} coordinates)" : drawn.Error, drawn.Ok ? ResultKind.Ok : ResultKind.Error);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private void Step(int by)
    {
        if (start + by < 0 || end + by > points.Length - 1)
        {
            return;
        }

        start += by;
        end += by;
    }

    private async Task SearchLegAsync()
    {
        busy = true;
        Show($"Searching {start} to {end}...", ResultKind.Info);
        try
        {
            RouteResponse response = await pathing.FindRouteAsync(
                new RouteRequest(null, uiMap, space, points[start], points[end]), Token);
            (string text, ResultKind kind) = RouteResults.Describe(response);
            Show($"Leg {start}-{end}: {text}", kind);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private void Edit()
    {
        if (selected is not null)
        {
            navigation.NavigateTo($"paths/edit/{PathUrl(selected.Name)}");
        }
    }

    private async Task DeleteAsync()
    {
        if (selected is null || !await js.InvokeAsync<bool>("confirm", Token, $"Delete {selected.Name}? Its screenshot stays."))
        {
            return;
        }

        ServiceResult deleted = await pathing.DeletePathAsync(selected.Name, Token);
        if (!deleted.Ok)
        {
            Show(deleted.Error, ResultKind.Error);
            return;
        }

        Show($"{selected.Name} deleted", ResultKind.Ok);
        selected = null;
        name = string.Empty;
        points = [];
        await LoadAsync();
    }

    /// <summary>A library name in a URL: each segment escaped, the '/' between them kept.</summary>
    public static string PathUrl(string libraryName)
    {
        return string.Join('/', libraryName.Split('/').Select(Uri.EscapeDataString));
    }

    private static string FileUrl(string libraryName)
    {
        return $"{WorldData.RecordedPaths}/{PathUrl(libraryName)}";
    }

    private void Show(string? text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }
}
