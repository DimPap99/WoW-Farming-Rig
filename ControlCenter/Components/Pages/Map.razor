@page "/Leaflet/{expansion?}/{continent?}/{zoom:int?}/{x:float?}/{y:float?}/"

@inherits ControlCenterComponent
@implements IAsyncDisposable

@inject IJSRuntime js
@inject PathingStatus status
@inject WorldCache worldCache

<PageTitle>Map · Control Center</PageTitle>

@if (!initialized && (world is null || !status.Online))
{
    <OfflineNotice Service="@status.Service" Reason="@status.Error" />
}
else if (!world!.World.HasMap)
{
    <div class="pa-page">
        <h1 class="pa-error-title">No map for @world.World.Client</h1>
        <p>
            There is no minimap art for the <code>@world.World.Era</code> era, so this client has no 2D map.
            The <a href="">live view</a> shows its navmesh and routes in 3D.
        </p>
    </div>
}
else
{
    <div class="pa-map">
        <div id="js-map">
            <div class="specText" id="adtClick"></div>
            <div class="specText" id="worldClick"></div>
            <div class="specText" id="mapClick"></div>
            <div class="specText" id="subZoneName"></div>
        </div>

        <Panel Title="Route search" Icon="magnifying-glass" Class="pa-panel--map">
            <SearchPanel @ref="search" Continent="@Continent" Locked="true" />
        </Panel>
    </div>
}

@code {
    // The client comes from the Pathing Service; the URL's segment is advisory only, because
    // every data file the map reads is the service's client's. The continent does come from the
    // URL: the map's own selector reloads the page at /Leaflet/<client>/<continent>.
    [Parameter] public string? expansion { get; set; }
    [Parameter] public string? continent { get; set; }
    [Parameter] public int zoom { get; set; } = 4;
    [Parameter] public float x { get; set; }
    [Parameter] public float y { get; set; }

    public const string DefaultContinent = "Azeroth";

    private WorldSnapshot? world;
    private DotNetObjectReference<Map>? dotNetRef;
    private SearchPanel? search;

    // The map is built once, when the service answers; it stays when the service goes away
    // later, and its own calls then say "offline".
    private bool initialized;

    private string Continent => continent ?? DefaultContinent;

    protected override async Task OnInitializedAsync()
    {
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
        Subscribe(() => status.Changed += Redraw, () => status.Changed -= Redraw);
        world = await worldCache.GetAsync();
    }

    // Offline at first, then back: the map is built once its element exists.
    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            world ??= await worldCache.GetAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (initialized || !status.Online || world is not { World.HasMap: true })
        {
            return;
        }

        initialized = true;
        string client = world.World.Client;

        // Handed to the map so custom points are mirrored into the search panel. See leaflet-poi.js.
        dotNetRef = DotNetObjectReference.Create(this);

        // A failure thrown into a render would end the whole circuit; it is reported instead.
        try
        {
            if (!string.IsNullOrEmpty(expansion) && !expansion.Equals(client, StringComparison.OrdinalIgnoreCase))
            {
                await js.InvokeVoidAsync("pathingUi.log", Token, $"URL client '{expansion}' ignored: the Pathing Service serves '{client}'.");
            }

            await js.InvokeVoidAsync("init", Token,
                client, Continent,
                zoom, x, y, true,
                world.World.NpcFlags,
                dotNetRef);
        }
        catch (JSException e)
        {
            await NotifyAsync($"The map did not start: {e.Message}");
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException)
        {
            // The page went away.
        }
    }

    private async Task NotifyAsync(string message)
    {
        try
        {
            await js.InvokeVoidAsync("pathingUi.log", Token, message);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    [JSInvokable("AddCustomPoi")]
    public void AddCustomPoi(float x, float y, float z, float mapId, string description)
    {
        search?.AddCustom(new NamedLocation(description, Continent, (int)mapId, new Point3(x, y, z)));
    }

    [JSInvokable("RemoveCustomPoi")]
    public void RemoveCustomPoi(string description)
    {
        search?.RemoveCustom(description);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        // The map, its Pixi overlay and its listeners outlive the element otherwise.
        await js.InvokeTeardownAsync("disposeMap");
        dotNetRef?.Dispose();
    }
}
