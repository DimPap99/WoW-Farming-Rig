@page "/forever-routes"
@page "/forever-routes/{Route}"

@inherits ControlCenterComponent

@using System.Threading

@inject IPathingClient pathing
@inject PathingStatus status
@inject WorldCache worldCache
@inject ZoneLookup zoneLookup
@inject IJSRuntime js

<PageTitle>Forever routes · Control Center</PageTitle>

@* WoW: Forever's route files, the agenda a run is assigned. Each is checked as a run loads it, and
   saved as text, so the comments that document a route survive; a route a run would refuse is
   never saved. *@

@if (!status.Online)
{
    <OfflineNotice Service="@status.Service" Reason="@status.Error" />
}
else
{
    <div class="pa-workspace">
        <header class="pa-workspace-header">
            <h1 class="pa-workspace-title">Forever routes</h1>
            <span class="pa-faint">@routes.Length route files, each checked as a run loads it</span>
            <span class="pa-spacer"></span>
            <div class="pa-input-group">
                <input class="pa-input" placeholder="new_route.json" aria-label="New route file name" @bind="newName" @bind:event="oninput" />
                <button class="pa-btn" type="button" disabled="@(string.IsNullOrWhiteSpace(newName) || busy)" @onclick="NewAsync">
                    <span class="oi oi-plus" aria-hidden="true"></span> New
                </button>
            </div>
        </header>

        <div class="pa-workspace-body">
            <nav class="pa-card pa-routes" aria-label="Route files">
                @if (routes.Length == 0)
                {
                    <p class="pa-faint">No route files yet: start one with a name above.</p>
                }
                @foreach (ForeverRouteInfo route in routes)
                {
                    <button type="button" class="pa-route @(route.Name == selected ? "is-selected" : null)"
                            title="@(route.Problem ?? string.Join("\n", route.Steps))" @onclick="() => OpenAsync(route.Name)">
                        <span class="pa-dot @(route.Problem is null ? "pa-dot--ok" : "pa-dot--error")" aria-hidden="true"></span>
                        <span class="pa-route-text">
                            <span class="pa-route-title">@route.Title</span>
                            <span class="pa-route-file">
                                @route.Name ·
                                @(route.Problem is null ? $"{route.Steps.Length} {(route.Steps.Length == 1 ? "step" : "steps")}{(route.Repeat ? ", repeats" : string.Empty)}" : "refused")
                            </span>
                        </span>
                    </button>
                }
            </nav>

            <section class="pa-card pa-route-editor" aria-label="Route file">
                @if (selected is null)
                {
                    <ResultLine Text="@result" Kind="@resultKind" />
                    <p class="pa-faint">Choose a route, or start a new one with a file name above.</p>
                }
                else
                {
                    <div class="pa-route-head">
                        <h2 class="pa-route-name">@(check?.Title ?? selected)</h2>
                        <span class="pa-faint">@selected@(isNew ? " (new)" : string.Empty)</span>
                        @if (Dirty)
                        {
                            <span class="pa-chip pa-chip--warn" title="The text differs from the saved file">unsaved</span>
                        }
                        <span class="pa-spacer"></span>
                        @if (!isNew)
                        {
                            <a class="pa-btn" href="@($"world?mode={WorldWorkspace.Route}&forever={Uri.EscapeDataString(selected)}")"
                               title="Open the saved file as nodes on the World page's Route mode, to change its way on the map">
                                <span class="oi oi-signpost" aria-hidden="true"></span> Open as nodes
                            </a>
                        }
                        <BusyButton Icon="check" Busy="@busy" OnClick="CheckAsync" Title="What a run would make of this text, without saving it">
                            Check
                        </BusyButton>
                        <button class="pa-btn" type="button" disabled="@(busy || !Dirty || isNew)" @onclick="RevertAsync" title="Throw the edits away and read the file again">
                            Revert
                        </button>
                        <BusyButton Class="pa-btn--primary" Icon="data-transfer-upload" Busy="@busy" Disabled="@(!Dirty && !isNew)" OnClick="SaveAsync"
                                    Title="Save the text as it is, once a run would load it">
                            Save
                        </BusyButton>
                        <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" disabled="@(busy || isNew)" title="Delete this route file" @onclick="DeleteAsync">
                            <span class="oi oi-trash" aria-hidden="true"></span>
                        </button>
                    </div>

                    <ResultLine Text="@result" Kind="@resultKind" />

                    <div class="pa-route-columns">
                        <div class="pa-route-text">
                        @* Bound as you type, so Save knows of an edit before the text box loses focus. *@
                        <textarea class="pa-code" spellcheck="false" aria-label="The route file's text" @ref="editor"
                                  @bind="text" @bind:event="oninput" @bind:after="Edited"></textarea>
                        <aside class="pa-route-check" aria-label="What a run does">
                            <h3 class="pa-list-heading">What a run does</h3>
                            @if (check is null)
                            {
                                <p class="pa-faint">Check the text to see its steps.</p>
                            }
                            else if (check.Problem is string problem)
                            {
                                <p class="pa-result pa-result--error">A run would refuse it: @problem</p>
                            }
                            else
                            {
                                <ol class="pa-steps">
                                    @foreach (string step in check.Steps)
                                    {
                                        <li>@step</li>
                                    }
                                </ol>
                                <p class="pa-faint">
                                    @(check.Repeat ? "Then it starts over, until the run's time bound." : "Then the run is complete.")
                                </p>
                            }
                            <div class="pa-divider"></div>
                            <p class="pa-faint">
                                Coordinates are the zone map's, 0 to 100. A step is a <code>Travel</code> (to <code>To</code>, through
                                <code>Via</code>) or a <code>Roam</code> (inside <code>Area</code> until <code>Until</code> holds:
                                <code>Kills</code>, <code>Minutes</code> or <code>Level</code>); a <code>Visit</code> goes to the nearest
                                <code>Role</code> (<code>vendor</code>, <code>innkeeper</code>, <code>classtrainer</code>...), an
                                <code>Npc</code>, or where a quest is given (<code>QuestStart</code>) or handed in (<code>QuestEnd</code>); a
                                <code>Quest</code> roams where quest <code>Id</code> sends until <code>Until</code> holds. A quest's id is in
                                the map's Layers. See <code>docs/forever-routes.md</code>.
                            </p>
                        </aside>
                        </div>

                        @* The route as the text says, drawn as it is written: the travel's legs planned, the roams' areas. *@
                        <div class="pa-route-map">
                            <WorldView @ref="view" Scene="@scene" Picking="@picking" OnPick="PickedAsync" OnMarker="MarkerClickedAsync">
                                <Panel Title="Layers" Icon="layers" Position="top-left" Collapsed="true">
                                    <WorldLayers @ref="layers" Id="pa-forever-layers" World="@world"
                                                 Continent="@(scene.Continent.Length == 0 ? null : scene.Continent)" OnChanged="LayersChanged"
                                                 OnFocus="CenterAsync" OnWaypoint="PickAtAsync"
                                                 WaypointTitle="Pick it: its coordinates, to insert in the text">
                                        <QuestActions Context="quest">
                                            <button class="pa-btn" type="button" @onclick="() => InsertQuestAsync(quest)"
                                                    title="Put its steps where the cursor is in the text: go where it is given, roam its camp, go where it is handed in">
                                                <span class="oi oi-code" aria-hidden="true"></span> Insert its steps
                                            </button>
                                        </QuestActions>
                                    </WorldLayers>
                                </Panel>
                                <div class="pa-route-pick">
                                    <div class="pa-actions">
                                        <button class="pa-btn @(picking ? "pa-btn--primary" : null)" type="button" @onclick="() => picking = !picking"
                                                title="@(picking ? "Click the map, or here to stop" : "Click the map for a point's coordinates")">
                                            <span class="oi oi-map-marker" aria-hidden="true"></span> @(picking ? "Click the map" : "Pick a point")
                                        </button>
                                        @if (picked is Picked p)
                                        {
                                            <button class="pa-btn" type="button" title="Put [x, y] where the cursor is in the text" @onclick="InsertAsync">Insert</button>
                                            <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Copy [x, y]" @onclick="CopyAsync">
                                                <span class="oi oi-clipboard" aria-hidden="true"></span>
                                            </button>
                                        }
                                    </div>
                                    @if (picked is Picked q)
                                    {
                                        <span class="pa-route-picked"><code>@q.Text</code> on @q.Zone.Name (@q.Zone.UiMapId.ToString(CultureInfo.InvariantCulture))</span>
                                    }
                                    @if (sketch is not null)
                                    {
                                        <span class="pa-faint">@sketch</span>
                                    }
                                </div>
                            </WorldView>
                        </div>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    /// <summary>The route to open, by file name.</summary>
    [Parameter] public string? Route { get; set; }

    private const string Template = """
        {
          // What this route does, for whoever runs it next. Coordinates are the zone
          // map's, 0 to 100, as the game shows them; "UIMapId" names the map (1411 is
          // Durotar), and a step may name another with its own "UIMapId". A step is a
          // Travel (walk to "To", through the "Via" points) or a Roam (hunt inside
          // "Area" until "Until" holds: "Kills", "Minutes" or "Level"); a Visit goes
          // to the nearest "Role" (vendor, innkeeper...), an "Npc", or a quest's
          // "QuestStart" or "QuestEnd"; a Quest roams where quest "Id" sends.
          "Name": "New route",
          "UIMapId": 1411,
          "Steps": [
            { "Travel": { "To": [52.5, 44.5] } }
          ],
          "Repeat": false
        }
        """;

    private ForeverRouteInfo[] routes = [];
    private string? selected;
    private string text = string.Empty;
    private string saved = string.Empty;
    private ForeverRouteInfo? check;
    private bool isNew;
    private string newName = string.Empty;
    private bool busy;
    private string? result;
    private ResultKind resultKind;

    private bool Dirty => text != saved;

    /// <summary>The map is drawn again this long after the typing stops, and while legs are being planned.</summary>
    private const int RedrawMs = 400;

    /// <summary>A quest's steps inserted roam its camp this long: the data has no counts, so the person sets the end.</summary>
    private const int QuestMinutes = 15;

    /// <summary>How the template indents a step.</summary>
    private const string StepIndent = "    ";

    /// <summary>A point clicked on the map: its zone, and its coordinates on that zone's map as the text writes them.</summary>
    private sealed record Picked(ZoneInfo Zone, string Text);

    private ElementReference editor;
    private WorldView? view;
    private WorldLayers? layers;
    private WorldSnapshot? world;
    private WorldScene scene = WorldScene.Empty(string.Empty);
    private WorldMarker[] routeMarkers = [];
    private RouteLegs legs = null!;
    private readonly CancellationTokenSource plans = new();
    private bool redrawQueued;
    private bool frameNext;
    private bool picking;
    private Picked? picked;
    private string? sketch;

    protected override void OnInitialized()
    {
        legs = new RouteLegs((request, token) => pathing.FindRouteAsync(request, token), () => QueueDraw());
        OnDispose(() =>
        {
            plans.Cancel();
            plans.Dispose();
        });
        Subscribe(() => status.Changed += Redraw, () => status.Changed -= Redraw);
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
    }

    // --- the map ------------------------------------------------------------------------------

    private void Edited()
    {
        QueueDraw();
    }

    // The map is drawn shortly, once for every edit or answer that comes meanwhile.
    private void QueueDraw(bool frame = false)
    {
        frameNext |= frame;
        _ = InvokeAsync(async () =>
        {
            if (redrawQueued)
            {
                return;
            }

            redrawQueued = true;
            try
            {
                await Task.Delay(RedrawMs, Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            redrawQueued = false;
            world ??= await worldCache.GetAsync();
            DrawRoute();
            StateHasChanged();
        });
    }

    // The steps as the text says: each travel point in order, the legs between them planned as the
    // bot would, each roam's area; on the continent of the first step's map.
    private void DrawRoute()
    {
        bool frame = frameNext;
        frameNext = false;
        if (world is null)
        {
            return;
        }

        if (!ForeverRouteSketch.TryRead(text, out ForeverSketch read, out string error))
        {
            sketch = error;
            return;
        }

        ForeverStepSketch[] steps = read.Steps;

        List<Point3> travel = [];
        List<WorldShape> shapes = [];
        string? continent = null;
        int mapId = -1;
        for (int i = 0; i < steps.Length; i++)
        {
            if (world.Zone(steps[i].UiMapId) is not ZoneInfo zone)
            {
                continue;
            }

            continent ??= zone.Continent;
            mapId = mapId < 0 ? zone.MapId : mapId;
            Point3[] points = [.. steps[i].Points.Select(p => ZoneMath.ToWorld(zone, new Point3(p.X, p.Y, 0)))];
            if (steps[i].Travel)
            {
                travel.AddRange(points);
            }
            else if (points.Length >= 2)
            {
                shapes.Add(WorldShape.Of($"roam-{i}", points.Length == 2 ? WorldShapes.Rectangle : WorldShapes.Polygon, WorldKinds.Area, points,
                    label: $"Step {i + 1}: roam"));
            }
        }

        if (continent is null)
        {
            sketch = "No step names a map the Pathing Service knows: give the route a \"UIMapId\".";
            return;
        }

        sketch = null;
        ContinentInfo? info = world.Continent(continent);
        WorldSnapshot snapshot = world;
        // Planned as the run plans: with the cost zones only when the route applies them.
        legs.Plan(travel.Zip(travel.Skip(1)), RouteSearch.Band, read.CostZones, at => snapshot.ZoneAt(info?.MapId ?? mapId, at)?.UiMapId ?? 0,
            plans.Token);

        List<WorldRoute> routes = [];
        List<WorldMarker> markers = [];
        for (int i = 0; i + 1 < travel.Count; i++)
        {
            Leg leg = legs.Get(travel[i], travel[i + 1], RouteSearch.Band, read.CostZones);
            routes.AddRange(RouteDrawing.Of($"leg-{i}", $"Leg {i + 1} to {i + 2}", leg.Status, leg.Points, travel[i], travel[i + 1], leg.Detail, markers));
        }

        if (travel.Count > 0)
        {
            shapes.Add(WorldShape.Of("travel", WorldShapes.Points, WorldKinds.Waypoints, travel));
        }

        routeMarkers = [.. markers];
        scene = new WorldScene(continent, [.. routes], [.. layers?.Markers ?? [], .. routeMarkers], ZoneLabels.Of(world, continent), frame,
            [.. shapes]);
    }

    // The layers' markers changed: the route's stay over them.
    private void LayersChanged()
    {
        scene = scene with { Markers = [.. layers?.Markers ?? [], .. routeMarkers], Frame = false, FrameOn = null };
    }

    private async Task MarkerClickedAsync(string id)
    {
        if (layers is not null)
        {
            await layers.MarkerClickedAsync(id);
        }
    }

    private async Task CenterAsync(Point3 at)
    {
        if (view is not null)
        {
            await view.CenterOnAsync(at);
        }
    }

    // A place of the layers' quest, picked as a click on the map would pick it.
    private async Task PickAtAsync(Point3 at)
    {
        await PickedAsync(new WorldPoint(at.X, at.Y, at.Z));
    }

    // A point clicked: named on the map of the zone the area grid puts it in.
    private async Task PickedAsync(WorldPoint point)
    {
        picking = false;
        world ??= await worldCache.GetAsync();
        if (world?.Continent(scene.Continent) is not ContinentInfo continent)
        {
            return;
        }

        Point3 at = point.ToPoint3();
        try
        {
            await zoneLookup.LearnAsync(continent.MapId, [at], Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (zoneLookup.Known(world, continent.MapId, at) is ZoneInfo zone)
        {
            Point3 map = ZoneMath.ToMap(zone, at);
            picked = new Picked(zone, FormattableString.Invariant($"[{map.X:0.##}, {map.Y:0.##}]"));
        }
    }

    private async Task InsertAsync()
    {
        if (picked is not null)
        {
            await js.InvokeVoidAsync("pathingUi.insertAtCursor", Token, editor, picked.Text);
        }
    }

    // A quest's steps as a route writes them, for the text, ending on a new line at the steps' indent so
    // a step after the cursor keeps its own; taking and handing the quest in are still the player's.
    private async Task InsertQuestAsync(QuestDetail quest)
    {
        string id = quest.Id.ToString(CultureInfo.InvariantCulture);
        string steps = $$"""
            { "Visit": { "QuestStart": {{id}} } },  // {{quest.Name}}
                { "Quest": { "Id": {{id}}, "Until": { "Minutes": {{QuestMinutes}} } } },
                { "Visit": { "QuestEnd": {{id}} } },

            """ + StepIndent;
        try
        {
            await js.InvokeVoidAsync("pathingUi.insertAtCursor", Token, editor, steps);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    private async Task CopyAsync()
    {
        if (picked is not null)
        {
            bool copied = await js.InvokeAsync<bool>("pathingUi.copy", Token, picked.Text);
            Show(copied ? $"{picked.Text} copied" : "The browser did not allow copying", copied ? ResultKind.Info : ResultKind.Warn);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await ListAsync();
        if (!string.IsNullOrEmpty(Route) && Route != selected)
        {
            await OpenAsync(Uri.UnescapeDataString(Route));
        }
    }

    private async Task ListAsync()
    {
        try
        {
            ServiceResult<ForeverRouteInfo[]> listed = await pathing.ListForeverRoutesAsync(Token);
            routes = listed.Value ?? [];
            if (!listed.Ok)
            {
                Show($"The route library is not available: {listed.Error}", ResultKind.Error);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            await ListAsync();
            StateHasChanged();
        });
    }

    private async Task OpenAsync(string name)
    {
        if (name != selected && !await MayLeaveAsync())
        {
            return;
        }

        await ReadAsync(name);
    }

    // Edits are not thrown away without asking.
    private async Task<bool> MayLeaveAsync()
    {
        return !Dirty || selected is null ||
               await js.InvokeAsync<bool>("confirm", Token, $"Leave {selected} without saving your edits?");
    }

    private async Task ReadAsync(string name)
    {
        try
        {
            ServiceResult<ForeverRouteDocument> read = await pathing.GetForeverRouteAsync(name, Token);
            if (!read.Ok)
            {
                Show(read.Status == 404 ? $"{name} is not in the library" : read.Error, ResultKind.Error);
                return;
            }

            selected = name;
            isNew = false;
            text = saved = read.Value.Text;
            check = read.Value.Info;
            Show(null, ResultKind.Info);
            picked = null;
            QueueDraw(frame: true);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task NewAsync()
    {
        string name = newName.Trim();
        if (!name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            name += ".json";
        }

        if (routes.Any(route => route.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            await OpenAsync(routes.First(route => route.Name.Equals(name, StringComparison.OrdinalIgnoreCase)).Name);
            return;
        }

        if (!await MayLeaveAsync())
        {
            return;
        }

        selected = name;
        isNew = true;
        text = Template;
        saved = string.Empty;
        check = null;
        newName = string.Empty;
        picked = null;
        QueueDraw(frame: true);
        Show("A new route: edit it, then Save.", ResultKind.Info);
    }

    private async Task CheckAsync()
    {
        if (selected is null)
        {
            return;
        }

        busy = true;
        try
        {
            ServiceResult<ForeverRouteInfo> checkedText = await pathing.CheckForeverRouteAsync(new ForeverRouteDraft(selected, text), Token);
            if (!checkedText.Ok)
            {
                Show(checkedText.Error, ResultKind.Error);
                return;
            }

            check = checkedText.Value;
            Show(check.Problem is null ? $"A run would load it: {check.Steps.Length} steps" : "A run would refuse it", check.Problem is null ? ResultKind.Ok : ResultKind.Error);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (selected is null)
        {
            return;
        }

        busy = true;
        try
        {
            // What was sent is what is saved: text typed while the save was under way is not (known issue 77).
            string sent = text;
            ServiceResult stored = await pathing.SaveForeverRouteAsync(selected, sent, Token);
            if (!stored.Ok)
            {
                Show(stored.Status == 400 ? $"Not saved: {stored.Error}" : stored.Error, ResultKind.Error);
                return;
            }

            saved = sent;
            isNew = false;
            await ListAsync();
            check = routes.FirstOrDefault(route => route.Name == selected) ?? check;
            Show($"{selected} saved", ResultKind.Ok);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RevertAsync()
    {
        if (selected is not null)
        {
            await ReadAsync(selected);
        }
    }

    private async Task DeleteAsync()
    {
        if (selected is null || !await js.InvokeAsync<bool>("confirm", Token, $"Delete {selected}?"))
        {
            return;
        }

        try
        {
            ServiceResult deleted = await pathing.DeleteForeverRouteAsync(selected, Token);
            if (!deleted.Ok)
            {
                Show(deleted.Error, ResultKind.Error);
                return;
            }

            Show($"{selected} deleted", ResultKind.Ok);
            selected = null;
            text = saved = string.Empty;
            check = null;
            await ListAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Show(string? message, ResultKind kind)
    {
        result = message;
        resultKind = kind;
    }
}
