@page "/map"

@inherits ControlCenterComponent

@inject IPathingClient pathing
@inject WorldCache worldCache
@inject PathingStatus status
@inject ZoneLookup zoneLookup
@inject IJSRuntime js

<PageTitle>Map · Control Center</PageTitle>

@* What is where in a zone, on the world view: NPCs by type, elites, herbs, veins, skinnable
   creatures, mailboxes and named places, each a layer to turn on; creatures searched by name on
   the continent; points marked and lines, areas and circles drawn, with their coordinates and what
   they measure. *@

<WorldView @ref="view" Scene="@scene" Tools="@Tools" @bind-Tool="tool" OnDrawn="MarkedAsync" OnMarker="MarkerClicked"
           OnEdited="EditedAsync" OnSelected="ShapeSelected">
    <Panel Title="Map" Icon="map" Position="top-left" Class="pa-panel--tall">
        @if (world is null)
        {
            <ResultLine Text="@(status.Online ? "Loading the world..." : "Waiting for the Pathing Service")" Kind="ResultKind.Info" />
        }
        else
        {
            <div class="pa-form">
                <div class="pa-field">
                    <label class="pa-label" for="pa-map-zone">Zone</label>
                    <select class="pa-select" id="pa-map-zone" value="@uiMap" @onchange="ZoneChosenAsync">
                        <option value="0" disabled>Choose a zone</option>
                        @foreach (IGrouping<string, ZoneInfo> group in Zones.GroupBy(z => z.Continent))
                        {
                            <optgroup label="@group.Key">
                                @foreach (ZoneInfo zone in group)
                                {
                                    <option value="@zone.UiMapId">@zone.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="pa-field">
                    <span class="pa-label">Show</span>
                    <div class="pa-layers">
                        @foreach (Layer layer in Layers)
                        {
                            <label class="pa-check pa-layer" title="@layer.Title">
                                <input type="checkbox" checked="@shown.Contains(layer.Id)" disabled="@(uiMap == 0)"
                                       @onchange="e => ToggleAsync(layer, e.Value is true)" />
                                <span class="pa-dot pa-layer-dot" style="background: @layer.Color" aria-hidden="true"></span>
                                @layer.Name
                                @if (points.TryGetValue(layer.Id, out SpawnPoint[]? found))
                                {
                                    <span class="pa-faint">@found.Length.ToString("N0", CultureInfo.InvariantCulture)</span>
                                }
                            </label>
                        }
                    </div>
                </div>

                <ResultLine Text="@result" Kind="@resultKind" />

                <div class="pa-field">
                    <label class="pa-label" for="pa-map-search">Find a creature on @(Zone?.Continent ?? "the continent")</label>
                    <div class="pa-input-group">
                        <input class="pa-input" id="pa-map-search" placeholder="A name, such as Hogger" @bind="search" @bind:event="oninput"
                               @onkeydown="SearchKeyAsync" disabled="@(uiMap == 0)" />
                        <button class="pa-btn pa-btn--icon" type="button" title="Find" disabled="@(uiMap == 0 || search.Trim().Length < 2)" @onclick="SearchAsync">
                            <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
                @if (found.Length > 0)
                {
                    <ul class="pa-waypoints" aria-label="Creatures found">
                        @foreach (NpcInfo npc in found)
                        {
                            <li class="pa-waypoint @(npc.Entry == chosen?.Entry ? "is-selected" : null)">
                                <button class="pa-waypoint-at" type="button" title="Show it on the map" @onclick="() => ShowFoundAsync(npc)">@npc.Name</button>
                                <span class="pa-waypoint-leg">@ZoneName(npc.Position)</span>
                            </li>
                        }
                    </ul>
                }

                <div class="pa-divider"></div>

                <div class="pa-field">
                    <span class="pa-label">Marks</span>
                    @if (marks.Count == 0)
                    {
                        <span class="pa-faint">Mark a point, or draw a line, an area or a circle, with the tools at the top right: where it is and what it measures show here.</span>
                    }
                    else
                    {
                        <ul class="pa-waypoints" aria-label="Marks">
                            @for (int i = 0; i < marks.Count; i++)
                            {
                                Mark mark = marks[i];
                                <li class="pa-waypoint @(mark.Id == selected ? "is-selected" : null)">
                                    <span class="pa-waypoint-n">@(i + 1)</span>
                                    <button class="pa-waypoint-at" type="button" title="@OnZoneMap(mark)" @onclick="() => FocusAsync(mark)">@Describe(mark)</button>
                                    <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Copy where it is: @OnZoneMap(mark)" @onclick="() => CopyAsync(mark)">
                                        <span class="oi oi-clipboard" aria-hidden="true"></span>
                                    </button>
                                    <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Remove it" @onclick="() => Unmark(mark)">
                                        <span class="oi oi-x" aria-hidden="true"></span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </Panel>
</WorldView>

@if (!status.Online)
{
    <OfflineNotice Service="@status.Service" Reason="@status.Error" />
}

@code {
    /// <summary>A layer of the map: what it shows, and how its markers look (its kind is the colour in world-view.js).</summary>
    private sealed record Layer(string Id, string Name, string Kind, string Color, string Title);

    // NPC types as layers too: their ids are the NpcFlags names, the service's.
    private static readonly string[] NpcTypes = ["vendor", "repair", "trainer", "flightmaster", "innkeeper"];

    /// <summary>A mark: a point, or a shape drawn to measure or to keep - a line, a polygon, a rectangle, a circle.</summary>
    private sealed record Mark(string Id, string Shape, Point3[] Points, float Radius);

    private static readonly WorldTool[] Tools =
    [
        new(WorldShapes.Point, "Mark a point: each click marks one; Esc stops", "Point"),
        new(WorldShapes.Line, "Draw a line to measure: click along it, then the last point again (or Enter)", "Line"),
        new(WorldShapes.Polygon, "Draw an area: click its corners, then the first again (or Enter); Esc cancels", "Polygon"),
        new(WorldShapes.Rectangle, "Draw a rectangle: two opposite corners", "Rectangle"),
        new(WorldShapes.Circle, "Draw a circle: its centre, then a point on its edge", "Circle"),
    ];

    private const string PlacesLayer = "places";

    private WorldView? view;
    private WorldSnapshot? world;
    private int uiMap;
    private string? tool;
    private readonly HashSet<string> shown = [];
    private readonly Dictionary<string, SpawnPoint[]> points = [];
    private string search = string.Empty;
    private NpcInfo[] found = [];
    private NpcInfo? chosen;
    private readonly List<Mark> marks = [];
    private int marked;
    private string? selected;
    private string? result;
    private ResultKind resultKind;
    private WorldScene scene = WorldScene.Empty(string.Empty);

    private ZoneInfo? Zone => world?.Zone(uiMap);

    private int MapId => Zone?.MapId ?? -1;

    // Zones only, on continents with tiles: a continent's or the world's map lists nothing of its own.
    private IEnumerable<ZoneInfo> Zones => world is null
        ? []
        : world.World.Zones.Where(z => z.AreaId != 0 && world.CanRoute(z.Continent)).OrderBy(z => z.Continent).ThenBy(z => z.Name);

    private IEnumerable<Layer> Layers =>
    [
        .. NpcTypes.Where(t => world?.World.NpcFlags.ContainsKey(t) == true)
            .Select(t => new Layer(t, char.ToUpperInvariant(t[0]) + t[1..] + "s", WorldKinds.Npc, "#39c5cf", $"NPCs who are a {t}, where each first spawns")),
        new(SpawnLayers.Elite, "Elites", "elite", "#e5534b", "Elite, rare and boss creatures, every spawn"),
        new(SpawnLayers.Herb, "Herbs", "herb", "#57ab5a", "Herb nodes"),
        new(SpawnLayers.Vein, "Veins", "vein", "#c69026", "Mining veins"),
        new(SpawnLayers.Skinnable, "Skinnable", "skinnable", "#d4b45a", "Creatures that can be skinned, every spawn"),
        new(SpawnLayers.Mailbox, "Mailboxes", "mailbox", "#6cb6ff", "Mailboxes"),
        new(PlacesLayer, "Places", "place", "#e6edf3", "The named places routes are planned between"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Subscribe(() => status.Changed += Redraw, () => status.Changed -= Redraw);
        Subscribe(() => status.Reconnected += Reload, () => status.Reconnected -= Reload);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        world = status.Online ? await worldCache.GetAsync() : null;
        Show();
    }

    private void Reload()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task ZoneChosenAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int chosenMap))
        {
            return;
        }

        uiMap = chosenMap;
        points.Clear();
        found = [];
        chosen = null;
        foreach (Layer layer in Layers.Where(l => shown.Contains(l.Id)))
        {
            await ReadAsync(layer);
        }

        Show(frame: true);
    }

    private async Task ToggleAsync(Layer layer, bool on)
    {
        if (on)
        {
            shown.Add(layer.Id);
            await ReadAsync(layer);
        }
        else
        {
            shown.Remove(layer.Id);
        }

        Show();
    }

    // A layer's points in the zone, read once per zone.
    private async Task ReadAsync(Layer layer)
    {
        if (Zone is not ZoneInfo zone || points.ContainsKey(layer.Id))
        {
            return;
        }

        try
        {
            if (layer.Id == PlacesLayer)
            {
                points[layer.Id] = [.. world!.LocationsOn(zone.Continent).Select(p => new SpawnPoint(0, p.Name, p.Position))];
                return;
            }

            ServiceResult<SpawnPoint[]> read = layer.Kind == WorldKinds.Npc
                ? Npcs(await pathing.GetNpcsAsync(zone.UiMapId, layer.Id, Token))
                : await pathing.GetSpawnsAsync(zone.UiMapId, layer.Id, Token);
            if (read.Ok)
            {
                points[layer.Id] = read.Value;
                Say(null, ResultKind.Info);
            }
            else
            {
                Say($"{layer.Name}: {read.Error}", ResultKind.Error);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static ServiceResult<SpawnPoint[]> Npcs(ServiceResult<NpcInfo[]> npcs)
    {
        return new ServiceResult<SpawnPoint[]>(npcs.Value?.Select(n => new SpawnPoint(n.Entry, n.Name, n.Position)).ToArray(), npcs.Status, npcs.Error);
    }

    private async Task SearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (MapId < 0 || search.Trim().Length < 2)
        {
            return;
        }

        try
        {
            ServiceResult<NpcInfo[]> read = await pathing.SearchNpcsAsync(MapId, search.Trim(), Token);
            found = read.Value ?? [];
            chosen = null;
            Say(read.Ok ? (found.Length == 0 ? $"No creature on {Zone?.Continent} is called that" : null) : read.Error,
                read.Ok ? ResultKind.Info : ResultKind.Error);
            if (read.Ok)
            {
                await zoneLookup.LearnAsync(MapId, [.. found.Select(n => n.Position)], Token);
            }
        }
        catch (OperationCanceledException)
        {
        }

        Show();
    }

    private async Task ShowFoundAsync(NpcInfo npc)
    {
        chosen = npc;
        Show();
        if (view is not null)
        {
            await view.CenterOnAsync(npc.Position);
        }
    }

    private void MarkerClicked(string id)
    {
        // A marker's title says what it is; a click on a found creature keeps it chosen.
        if (found.FirstOrDefault(n => $"found-{n.Entry.ToString(CultureInfo.InvariantCulture)}" == id) is NpcInfo npc)
        {
            chosen = npc;
            Show();
        }
    }

    // A point keeps its tool, a click a point; a shape is drawn once, then selected to change.
    private async Task MarkedAsync(WorldDrawn drawn)
    {
        Mark mark = new($"mark-{++marked}", drawn.Shape, drawn.Points, drawn.Radius);
        marks.Add(mark);
        if (drawn.Shape != WorldShapes.Point)
        {
            selected = mark.Id;
            tool = null;
        }

        Show();
        await LearnAsync(mark);
    }

    private async Task EditedAsync(WorldEdited edited)
    {
        int index = marks.FindIndex(m => m.Id == edited.Id);
        if (index < 0)
        {
            return;
        }

        marks[index] = marks[index] with { Points = edited.Points, Radius = edited.Radius };
        Show();
        await LearnAsync(marks[index]);
    }

    private void ShapeSelected(string? id)
    {
        selected = id;
        Show();
    }

    private async Task FocusAsync(Mark mark)
    {
        selected = mark.Shape == WorldShapes.Point ? selected : mark.Id;
        Show();
        if (view is not null)
        {
            await view.CenterOnAsync(Middle(mark));
        }
    }

    private void Unmark(Mark mark)
    {
        marks.Remove(mark);
        selected = selected == mark.Id ? null : selected;
        Show();
    }

    // Where it is as a player reads it, for a Forever route or a note: the zone map's coordinates of
    // its points ([x, y] each; a rectangle's two corners, as a roam's Area takes them).
    private async Task CopyAsync(Mark mark)
    {
        try
        {
            bool copied = await js.InvokeAsync<bool>("pathingUi.copy", Token, OnZoneMap(mark));
            Say(copied ? $"Copied mark {marks.IndexOf(mark) + 1}: {OnZoneMap(mark)}" : "The browser did not allow copying", copied ? ResultKind.Ok : ResultKind.Warn);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    private async Task LearnAsync(Mark mark)
    {
        try
        {
            await zoneLookup.LearnAsync(MapId, [Middle(mark), .. mark.Points], Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    // What a mark is and measures: "Durotar 52.3, 44.1", "Line · 1,204 yd", "Circle · 85 yd round".
    private string Describe(Mark mark)
    {
        Point3[] p = mark.Points;
        return mark.Shape switch
        {
            WorldShapes.Point => ZoneLabels.Where(Known(p[0]), p[0]),
            WorldShapes.Line => $"Line · {Words.Yards(RouteGeometry.Length(p))}",
            WorldShapes.Polygon => $"Polygon · {Words.Count(p.Length, "corner")} · {Words.SquareYards(Area(p))}",
            WorldShapes.Rectangle => string.Create(CultureInfo.InvariantCulture,
                $"Rectangle · {MathF.Abs(p[1].Y - p[0].Y):N0} × {MathF.Abs(p[1].X - p[0].X):N0} yd"),
            WorldShapes.Circle => $"Circle · {Words.Yards(mark.Radius)} round {ZoneLabels.Where(Known(p[0]), p[0])}",
            _ => mark.Shape,
        };
    }

    // Its points in the zone map's coordinates, where its middle's zone is known; else world yards.
    private string OnZoneMap(Mark mark)
    {
        Point3 middle = Middle(mark);
        ZoneInfo? zone = Known(middle);
        IEnumerable<string> points = mark.Points.Select(p =>
        {
            Point3 at = zone is null ? p : ZoneMath.ToMap(zone, p);
            return string.Create(CultureInfo.InvariantCulture, $"[{at.X:F1}, {at.Y:F1}]");
        });
        string where = mark.Points.Length == 1 ? points.First() : $"[{string.Join(", ", points)}]";
        return zone is null ? $"world yards {where}" : $"{zone.Name} {where}";
    }

    private static Point3 Middle(Mark mark)
    {
        return new Point3(mark.Points.Average(p => p.X), mark.Points.Average(p => p.Y), 0);
    }

    // A polygon's area by the shoelace formula, in square yards.
    private static float Area(Point3[] p)
    {
        float twice = 0;
        for (int i = 0; i < p.Length; i++)
        {
            Point3 a = p[i];
            Point3 b = p[(i + 1) % p.Length];
            twice += (a.X * b.Y) - (b.X * a.Y);
        }

        return MathF.Abs(twice) / 2;
    }

    private ZoneInfo? Known(Point3 at) => world is null ? null : zoneLookup.Known(world, MapId, at);

    private string ZoneName(Point3 at) => Known(at)?.Name ?? "?";

    private void Say(string? text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }

    // Every shown layer's markers, the creature found and the marked points.
    private void Show(bool frame = false)
    {
        string continent = Zone?.Continent ?? world?.World.Continents.FirstOrDefault(c => c.Tiles > 0)?.Name ?? string.Empty;
        List<WorldMarker> markers = [];
        foreach (Layer layer in Layers.Where(l => shown.Contains(l.Id)))
        {
            if (points.TryGetValue(layer.Id, out SpawnPoint[]? at))
            {
                for (int i = 0; i < at.Length; i++)
                {
                    SpawnPoint p = at[i];
                    markers.Add(WorldMarker.At($"{layer.Id}-{i.ToString(CultureInfo.InvariantCulture)}", layer.Kind, p.At, null,
                        p.Detail is null ? p.Name : $"{p.Name} · {p.Detail}"));
                }
            }
        }

        foreach (NpcInfo npc in found)
        {
            bool isChosen = npc.Entry == chosen?.Entry;
            markers.Add(WorldMarker.At($"found-{npc.Entry.ToString(CultureInfo.InvariantCulture)}", isChosen ? WorldKinds.End : WorldKinds.Npc,
                npc.Position, isChosen ? npc.Name : null, npc.Name));
        }

        // Points as markers, numbered; shapes as shapes, numbered where their names show, editable.
        List<WorldShape> shapes = [];
        for (int i = 0; i < marks.Count; i++)
        {
            Mark mark = marks[i];
            string number = (i + 1).ToString(CultureInfo.InvariantCulture);
            if (mark.Shape == WorldShapes.Point)
            {
                markers.Add(WorldMarker.At(mark.Id, WorldKinds.Mark, mark.Points[0], number));
            }
            else
            {
                shapes.Add(WorldShape.Of(mark.Id, mark.Shape, WorldKinds.Mark, mark.Points, editable: true, label: number, radius: mark.Radius));
            }
        }

        // A zone chosen is framed whole: its map's corners.
        float[]? frameOn = frame && Zone is ZoneInfo zone
            ? WorldPoints.Flatten([ZoneMath.ToWorld(zone, new Point3(0, 0, 0)), ZoneMath.ToWorld(zone, new Point3(100, 100, 0))])
            : null;
        scene = new WorldScene(continent, [], [.. markers], ZoneLabels.Of(world, continent), Shapes: [.. shapes], Selected: selected,
            FrameOn: frameOn);
    }
}
