@* The route designer's Forever export: the waypoints and areas as a route file a run is assigned
   (ForeverExport), which the Pathing Service checks as a run loads it before saving it. *@

@inherits ControlCenterComponent

@inject IPathingClient pathing
@inject IJSRuntime js

<details class="pa-details">
    <summary>Forever route</summary>
    <div class="pa-form">
        <div class="pa-row">
            <div class="pa-field pa-grow2">
                <label class="pa-label" for="pa-route-forever">File</label>
                <input class="pa-input" id="pa-route-forever" placeholder="my_route.json" @bind="name" @bind:event="oninput" />
            </div>
            <div class="pa-field pa-grow">
                <label class="pa-label" for="pa-route-kills" title="Each roam ends after this many kills">Kills per area</label>
                <input class="pa-input" id="pa-route-kills" type="number" min="1" @bind="kills" />
            </div>
        </div>
        <BusyButton Class="pa-btn--primary" Icon="data-transfer-upload" Busy="@busy"
                    Disabled="@(name.Trim().Length == 0 || (Waypoints.Count == 0 && Areas.Count == 0))"
                    OnClick="SaveAsync" Title="Travel through the waypoints, roaming each area on the way">
            Save as a Forever route
        </BusyButton>
        <ResultLine Text="@result" Kind="@resultKind" />
        @if (saved is not null)
        {
            <a class="pa-link" href="@($"forever-routes/{Uri.EscapeDataString(saved)}")">Open @saved in Forever routes</a>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired] public WorldSnapshot World { get; set; } = null!;

    /// <summary>The continent the waypoints and areas are on.</summary>
    [Parameter, EditorRequired] public string Continent { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<Point3> Waypoints { get; set; } = [];

    /// <summary>Each area's corners: two opposite ones, or three or more in order.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyList<Point3>> Areas { get; set; } = [];

    private string name = string.Empty;
    private int kills = ForeverExport.DefaultKills;
    private string? saved;
    private bool busy;
    private string? result;
    private ResultKind resultKind;

    private async Task SaveAsync()
    {
        string file = name.Trim();
        if (World.Continent(Continent) is not ContinentInfo continent || file.Length == 0)
        {
            return;
        }

        if (!file.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            file += ".json";
        }

        string title = System.IO.Path.GetFileNameWithoutExtension(file).Replace('_', ' ');
        if (!ForeverExport.TryBuild(title, Waypoints, Areas, kills, World.World.Zones, continent.MapId, out string text, out string error))
        {
            Show(error, ResultKind.Error);
            return;
        }

        busy = true;
        try
        {
            ServiceResult<ForeverRouteInfo[]> listed = await pathing.ListForeverRoutesAsync(Token);
            if (listed.Value?.Any(r => r.Name.Equals(file, StringComparison.OrdinalIgnoreCase)) == true &&
                !await js.ConfirmAsync($"Replace the Forever route {file}?", Token))
            {
                return;
            }

            ServiceResult written = await pathing.SaveForeverRouteAsync(file, text, Token);
            saved = written.Ok ? file : null;
            name = written.Ok ? file : name;
            Show(written.Ok ? $"Saved {file}: a run can be assigned it" : written.Error, written.Ok ? ResultKind.Ok : ResultKind.Error);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            busy = false;
        }
    }

    private void Show(string? text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }
}
