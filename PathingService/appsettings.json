{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  // Rolling log beside the service; an empty value turns the file off.
  "LogFile": "out.log",
  "AllowedHosts": "*",
  // WoW: Forever's installed client, read through CASC for bakes and terrain (--exp=forever only).
  // Install and Listfile go together; without them a Forever instance serves baked tiles only.
  "ForeverCasc": {
    "Install": "",
    "Listfile": "",
    "Product": "wow_classic_beta",
    "Cache": ""
  },
  // Navmesh options as in BlazorServer/appsettings.json. Bake values name the tile cache
  // directory, so they must match the bake that produced the tiles; Query values are
  // per-request and safe to tune.
  "Navmesh": {
    "Bake": {
      "AgentRadius": 0.5,
      "AgentMaxClimb": 1.6,
      "WalkableSlope": 48,
      "MinWorldZ": { "Expansion01": -700 }
    },
    "Query": {
      "EdgeMargin": 1.5,
      "PathSpacing": 2.5,
      "CorridorTiles": 2,
      "CorridorMaxTiles": 4,
      "CorridorWiden": true,
      "SkipWidenShortRoutes": true,
      "RoadCore": 8
    }
  }
}
