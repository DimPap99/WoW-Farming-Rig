<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Pathing Service (docs/service-architecture.md). Plain net10.0 so it runs on
       Linux and macOS: it references the pathing chain, the contracts and ServiceClients (for
       the shared key policy) only, never Core,
       Game, WinAPI or Frontend. ForeverCasc (not in the .sln; MSBuild builds it as a
       reference) reads WoW: Forever's geometry for bakes and terrain. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceHosting\ServiceHosting.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\DataConfig\DataConfig.csproj" />
    <ProjectReference Include="..\PPather\PPather.csproj" />
    <ProjectReference Include="..\ServiceClients\ServiceClients.csproj" />
    <ProjectReference Include="..\SharedLib\SharedLib.csproj" />
    <ProjectReference Include="..\Utilities\ForeverCasc\ForeverCasc.csproj" />
  </ItemGroup>

</Project>
