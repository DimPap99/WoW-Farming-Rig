<Project Sdk="Microsoft.NET.Sdk">

  <!-- A simulated bot agent for checking the Control Center's fleet pages without a game: BotAgent's
       AddBotAgent, as HeadlessServer composes it, with made-up runtimes. Plain net10.0. Not in the
       .sln: build it with `dotnet build Utilities/SimAgent`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BotAgent\BotAgent.csproj" />
  </ItemGroup>

</Project>
