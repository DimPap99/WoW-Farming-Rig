<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Leaflet map's scripts, styles, libraries and icon atlas: static files only, no code
       and no project references. BlazorServer (through Frontend) and the Control Center both
       serve them at _content/MapAssets/, so the map exists once. See CLAUDE.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>
