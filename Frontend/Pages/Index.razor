@page "/"

@inject ILogger logger

@inject IBotController botController
@inject IJSRuntime JSRuntime
@inject AddonConfigurator addonConfigurator
@inject IServiceProvider services
@inject StartupClientVersion client
@inject ForeverVisualBarTracker visualBars

@implements IDisposable

<style>
    .main-layout {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .top-section {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 10px;
    }

    .left-panel {
        flex: 1 1 70%;
    }

    .right-panel {
        flex: 1 1 30%;
        max-width: 300px; /* Optional max width for BagChanges */
    }

    .bottom-section {
        width: 100%;
    }
</style>

<div class="container-fluid">
    <div class="row">
        @if (client.Version == ClientVersion.Forever)
        {
            <div class="col-sm">
                <div class="card">
                    <div class="card-header">WoW: Forever beta compatibility</div>
                    <div class="card-body">
                        <p>Read-only diagnostic mode. The bot cannot start yet: its gameplay data and navigation are not ported to Forever.</p>
                        @if (visualBars.TryGetLatest(out var bars))
                        {
                            <p>Player health: @bars.PlayerHealth.ToString("P0")<br />
                               Player power: @bars.PlayerPower.ToString("P0")<br />
                               Target bar fill: @bars.TargetHealth.ToString("P0")<br />
                               Target presence: @TargetPresenceText(bars.TargetPresent)</p>
                            <p class="text-muted">Target health is usable only when target presence is confirmed.</p>
                            @if (bars.ActionBar is { } actionBar)
                            {
                                <p>Action bar: @actionBar.OccupiedCount occupied, @actionBar.ReadableCount / @VisualActionBarSnapshot.SlotCount readable slots</p>
                                <p>Main bar: @MainBarText(bars)</p>
                                <p class="text-muted">Cooldown is the remaining fraction of the spell's cooldown, not seconds.</p>
                            }
                            else
                            {
                                <p class="text-muted">No valid full action-bar snapshot yet.</p>
                            }
                            @if (bars.Position is { } position)
                            {
                                <p>Map @position.UIMapId: @position.MapX.ToString("F5"), @position.MapY.ToString("F5")<br />
                                   Facing: @position.Direction.ToString("F2") radians</p>
                            }
                            else
                            {
                                <p class="text-muted">No valid position marker yet.</p>
                            }
                            <p class="text-muted">Visual calibration: @bars.Calibration.ToString("P0"). Data expires if screen capture stops.</p>
                        }
                        else
                        {
                            <p>No fresh visual data. In the game, type <code>/forevervisual</code> to show the diagnostic bars.</p>
                        }
                    </div>
                </div>
            </div>
        }
        else if (AddonConfig.Exists() && FrameConfig.Exists())
        {
            <div class="col-sm main-layout">
                <div class="top-section">
                    <div class="left-panel">
                        <RouteComponent Size="400" />
                    </div>
                    <div class="right-panel">
                        <RecentKillsComponent />
                        <BagChanges />
                    </div>
                </div>

                <div class="bottom-section">
                    @if (DataConfig.HasLeaflet(client.Version.ToString()))
                    {
                        <LeafletComponent Size="400px" />
                    }
                </div>
            </div>

            <div class="col-sm">
                @if (updateAvailable)
                {
                    <div class="card" style="margin-bottom: 10px">
                        <div class="card-header">
                            <b>New Addon version available!</b>
                            <span class="float-right">
                                <button class="btn btn-sm btn-success">
                                    <NavLink class="nav-link" href="AddonConfiguration">
                                        <span style="text-decoration: none;font-weight: bold;color: white;">Update</span>
                                    </NavLink>
                                </button>
                            </span>
                        </div>
                    </div>
                }

                <BotHeader ShowActiveGoal="false" Hide="@(botController.IsBotActive)" />
                <ProfileSelectorComponent Hide="@(botController.IsBotActive)" />

                @if (botController.ClassConfig == null)
                {
                    <PathSelectorComponent Hide="@(botController.IsBotActive)" />
                }
                else if (!botController.IsBotActive && botController.ClassConfig!.Mode != Mode.AttendedGrind)
                {
                    if (botController.ClassConfig!.Paths.Length > 1)
                    {
                        <Accordion>
                            <AccordionItem Title="Override Paths">
                                <Content>
                                    @foreach (var pathSettings in botController.ClassConfig!.Paths)
                                    {
                                        <PathSelectorComponent Hide="@(botController.IsBotActive)"
                                                               Target="@(pathSettings)"
                                                               TargetIndex="@(Array.IndexOf(botController.ClassConfig!.Paths, pathSettings))" />
                                    }
                                </Content>
                            </AccordionItem>
                        </Accordion>
                    }
                    else if (botController.ClassConfig!.Paths.Length == 1)
                    {
                        <PathSelectorComponent Hide="@(botController.IsBotActive)"
                                               Target="@(botController.ClassConfig!.Paths.First())"
                                               TargetIndex="0" />
                    }
                }

                <GoalsComponent />
            </div>
        }
        else if (!AddonConfig.Exists())
        {
            <AddonConfiguration />
        }
        else if (!FrameConfig.Exists())
        {
            <FrameConfiguration />
        }
    </div>
</div>

<div id="tooltip" display="none" style="position: absolute; display: none;"></div>


@code {
    private bool updateAvailable;
    private System.Threading.Timer? foreverRefreshTimer;

    private static string TargetPresenceText(bool? present) => present switch
    {
        true => "present",
        false => "absent",
        null => "unknown"
    };

    // The main-bar slots the Forever runtime can press: what each holds and
    // how much of its cooldown remains, from the add-on's checked grids.
    private static string MainBarText(VisualBarSample bars)
    {
        if (bars.ActionBar is not { } bar)
            return "unavailable";
        System.Collections.Generic.List<string> parts = [];
        for (int slot = 1; slot <= VisualCooldownGridSnapshot.SlotCount; slot++)
        {
            if (bar.GetSlot(slot) is not { } action || action.Kind == VisualActionKind.Empty)
                continue;
            string cooldown = bars.Cooldowns?.GetSlot(slot) switch
            {
                null => "cooldown unknown",
                0 => "ready",
                double fill => $"{fill:P0} cooldown"
            };
            parts.Add($"{slot}: {action.Kind} {action.Id}, {cooldown}");
        }
        return parts.Count == 0 ? "empty" : string.Join("; ", parts);
    }

    protected override void OnInitialized()
    {
        botController.StatusChanged += OnStatusChanged;
        botController.ProfileLoaded += OnStatusChanged;
        if (client.Version == ClientVersion.Forever)
            foreverRefreshTimer = new(_ => OnStatusChanged(), null, 250, 250);
        else
            _ = services.GetService(typeof(FrontendUpdate));

        updateAvailable = addonConfigurator.UpdateAvailable();
    }

    public void Dispose()
    {
        botController.StatusChanged -= OnStatusChanged;
        botController.ProfileLoaded -= OnStatusChanged;
        foreverRefreshTimer?.Dispose();
    }

    private void OnStatusChanged()
    {
        base.InvokeAsync(StateHasChanged);
    }
}
