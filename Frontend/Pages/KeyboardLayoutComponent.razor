@inherits SubscribingComponentBase
@inject KeyBindingsReader keyBindingsReader
@inject ActionBarTextureReader actionBarTextureReader
@inject ActionBarSlotValidator actionBarSlotValidator
@inject SpellBookReader spellBookReader
@inject IBotController botController
@inject Core.Database.IconDB iconDB
@inject PlayerReader playerReader
@inject ILoggerFactory logFactory
@inject BagReader bagReader
@inject EquipmentReader equipmentReader
@inject ExecGameCommand exec
@inject AddonConfigurator addonConfigurator
@inject WowProcessInput wowInput
@inject ActionBarCostReader actionBarCostReader
@inject ActionBarCooldownReader actionBarCooldownReader
@inject ActionBarBits<IUsableAction> usableAction
@inject ActionBarBits<ICurrentAction> currentAction

@if (bindings is null || slots is null)
{
    <div class="card mt-1">
        <div class="card-header">
            Keyboard Bindings
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                Please load a class profile first to view key bindings.
            </div>
        </div>
    </div>
}
else
{
<div class="card mt-1">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Keyboard Bindings</span>
        <div class="d-flex align-items-center">
            @if (bindings.Missing.Count > 0)
            {
                <span class="badge bg-warning me-1">@bindings.Missing.Count missing</span>
            }
            @if (bindings.BoundCount > 0)
            {
                <span class="badge bg-success me-1">@bindings.BoundCount OK</span>
            }
            <span class="badge @(keyBindingsReader.IsInitialized ? "bg-info" : "bg-secondary") me-2">
                @(keyBindingsReader.IsInitialized ? $"{keyBindingsReader.Count} in-game" : "Loading...")
            </span>
            @if (bindings.MissingActionBarBindings)
            {
                <button class="btn btn-sm btn-outline-warning me-1" @onclick="SetupBindings" title="Run /@addonConfigurator.Config.CommandBindings to set default action bar key bindings">
                    Setup Bindings
                </button>
            }
            @if (bindings.MissingCustomActions)
            {
                <button class="btn btn-sm btn-outline-warning me-1" @onclick="SetupActions" title="Run /@addonConfigurator.Config.CommandActions to create custom action buttons">
                    Setup Actions
                </button>
            }
            <button class="btn btn-sm btn-primary me-1" @onclick="SyncActionBar" disabled="@(actionBarPopulator == null)">
                <span>Sync Actionbar</span>
            </button>
            <InitButton Size="ButtonSize.Small" />
        </div>
    </div>
    <div class="card-body">
        @if (bindings.Missing.Count > 0)
        {
            <div class="alert alert-warning mb-2 p-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Missing key bindings!</strong> Set these bindings in-game or run <code>/@addonConfigurator.Config.CommandBindings</code> to apply defaults.
                    </div>
                    <button class="btn btn-sm btn-outline-warning" type="button"
                            data-bs-toggle="collapse" data-bs-target="#mismatchDetails">
                        Details
                    </button>
                </div>
                <div class="collapse mt-2" id="mismatchDetails">
                    <table class="table table-sm table-dark mb-0">
                        <thead>
                            <tr>
                                <th>Binding</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (BindingID missing in bindings.Missing)
                            {
                                <tr>
                                    <td>@missing.ToString()</td>
                                    <td><span class="badge bg-warning">Not bound in-game</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="keyboard-wrapper">
        <div class="keyboard-layout">
        <div class="keyboard-container">
            @* Function Row - Slots 61-72 *@
            <div class="keyboard-row">
                <div class="key key-sm">Esc</div>
                @for (int i = 1; i <= 12; i++)
                {
                    @SlotKey(KeyboardKeys.ConsoleKeyOf($"F{i}"), $"F{i}", KeyboardKeys.FunctionKeySlotBase + i, "key-sm", 6)
                }
            </div>

            @* Number Row - Slots 1-12 *@
            <div class="keyboard-row">
                <div class="key">`</div>
                @foreach (var key in KeyboardKeys.NumberRow)
                {
                    @SlotKey(KeyboardKeys.ConsoleKeyOf(key), key, KeyboardKeys.MainBarSlot(key), string.Empty, 6)
                }
                <div class="key key-wide">Bksp</div>
            </div>

            @* QWERTY Row *@
            <div class="keyboard-row">
                <div class="key key-tab">Tab</div>
                @foreach (var key in KeyboardKeys.QwertyRow)
                {
                    @PlainKey(KeyboardKeys.ConsoleKeyOf(key), key, string.Empty)
                }
            </div>

            @* ASDF Row *@
            <div class="keyboard-row">
                <div class="key key-caps">Caps</div>
                @foreach (var key in KeyboardKeys.AsdfRow)
                {
                    @PlainKey(KeyboardKeys.ConsoleKeyOf(key), key, string.Empty)
                }
                <div class="key key-enter">Enter</div>
            </div>

            @* ZXCV Row *@
            <div class="keyboard-row">
                <div class="key key-shift">Shift</div>
                @foreach (var key in KeyboardKeys.ZxcvRow)
                {
                    @PlainKey(KeyboardKeys.ConsoleKeyOf(key), key, string.Empty)
                }
                <div class="key key-shift">Shift</div>
            </div>

            @* Space Row *@
            <div class="keyboard-row">
                <div class="key key-ctrl">Ctrl</div>
                <div class="key key-sm">Win</div>
                <div class="key key-sm">Alt</div>
                @PlainKey(ConsoleKey.Spacebar, "Space", "key-space")
                <div class="key key-sm">Alt</div>
                <div class="key key-sm">Win</div>
                <div class="key key-ctrl">Ctrl</div>
            </div>
        </div>

        @* Navigation Keys *@
        <div class="keyboard-container mt-2">
            <div class="keyboard-row">
                @PlainKey(ConsoleKey.Insert, "Ins", "key-nav")
                @PlainKey(ConsoleKey.Home, "Home", "key-nav")
                @PlainKey(ConsoleKey.PageUp, "PgUp", "key-nav")
            </div>
            <div class="keyboard-row">
                @PlainKey(ConsoleKey.Delete, "Del", "key-nav")
                @PlainKey(ConsoleKey.End, "End", "key-nav")
                @PlainKey(ConsoleKey.PageDown, "PgDn", "key-nav")
            </div>
        </div>

        @* Numpad - Slots 49-58 *@
        <div class="keyboard-container mt-2">
            <div class="keyboard-row">
                @for (int i = 7; i <= 9; i++)
                {
                    @SlotKey(KeyboardKeys.NumpadKey(i), i.ToString(), KeyboardKeys.NumpadSlot(i), "key-num", 5)
                }
                @PlainKey(ConsoleKey.Add, "+", "key-num")
            </div>
            <div class="keyboard-row">
                @for (int i = 4; i <= 6; i++)
                {
                    @SlotKey(KeyboardKeys.NumpadKey(i), i.ToString(), KeyboardKeys.NumpadSlot(i), "key-num", 5)
                }
                @PlainKey(ConsoleKey.Subtract, "-", "key-num")
            </div>
            <div class="keyboard-row">
                @for (int i = 1; i <= 3; i++)
                {
                    @SlotKey(KeyboardKeys.NumpadKey(i), i.ToString(), KeyboardKeys.NumpadSlot(i), "key-num", 5)
                }
                @PlainKey(ConsoleKey.Multiply, "*", "key-num")
            </div>
            <div class="keyboard-row">
                @SlotKey(ConsoleKey.NumPad0, "0", KeyboardKeys.NumpadSlot(0), "key-num key-num0", 8)
                @PlainKey(ConsoleKey.Divide, "/", "key-num")
            </div>
        </div>
        </div> @* keyboard-layout *@

        @* Stance/Form Bars *@
        @if (ActionBarSlotMap.StanceBars(playerReader.Class) is var stanceBars && stanceBars.Length > 0)
        {
            <div class="stance-bars mt-3">
                <h6 class="text-muted mb-2">Stance/Form Bars</h6>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var stance in stanceBars)
                    {
                        <div class="stance-bar-section">
                            <div class="stance-bar-label">@stance.Name</div>
                            <div class="keyboard-container">
                                <div class="keyboard-row">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        int slot = stance.BaseSlot + i;
                                        var action = slots[slot];
                                        var iconUrl = GetIconUrl(slot);
                                        var hasTexture = actionBarTextureReader.TryGetTexture(slot, out int textureId);
                                        <div class="key key-sm @SlotClass(slot, action)" title="@GetStanceSlotTooltip(slot, action)">
                                            @if (iconUrl != null)
                                            {
                                                <img src="@iconUrl" class="key-icon" alt="" />
                                            }
                                            else if (action != null)
                                            {
                                                <span class="key-slot">@i</span>
                                                <div class="key-spell">@TruncateName(action.Name, 5)</div>
                                            }
                                            else if (hasTexture && textureId > 0)
                                            {
                                                <span class="key-slot">@i</span>
                                                <div class="key-spell">tex:@textureId</div>
                                            }
                                            else
                                            {
                                                <span class="key-slot-empty">@i</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        </div> @* keyboard-wrapper *@

        @* Legend *@
        <div class="mt-3">
            <span class="badge bg-success me-2">Bound in-game</span>
            <span class="badge bg-warning text-dark me-2">Not bound</span>
            <span class="badge bg-info me-2">In-game (extra)</span>
            <span class="badge bg-primary me-2">Configured Action</span>
            <span class="badge" style="background:#3a3a5e">In-game Action</span>
        </div>

        @* Missing Spells Section *@
        @{
            var actionBarIssues = GetActionBarIssues();
            var resolvableIssues = actionBarIssues.Where(i => i.CanResolve).ToList();
            var hardErrors = actionBarIssues.Where(i => !i.CanResolve).ToList();
        }
        @if (actionBarIssues.Count > 0)
        {
            <div class="mt-3 border-top pt-3">
                <h6 class="text-muted mb-2">Action Bar Issues</h6>

                @if (resolvableIssues.Count > 0)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-warning">Resolvable (@resolvableIssues.Count)</span>
                            @if (resolvableIssues.Count > 1)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="ResolveAllActionBarIssues">
                                    Resolve All
                                </button>
                            }
                        </div>
                        <table class="table table-sm table-dark mb-0">
                            <thead>
                                <tr>
                                    <th>Spell</th>
                                    <th>Slot</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in resolvableIssues)
                                {
                                    <tr>
                                        <td>@issue.SpellName</td>
                                        <td>@issue.Slot</td>
                                        <td>
                                            @if (issue.Status == SlotValidationStatus.EmptySlot)
                                            {
                                                <span class="badge bg-warning text-dark">Empty</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Mismatch</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-xs btn-outline-success" @onclick="() => ResolveActionBarIssue(issue)">
                                                Place
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (hardErrors.Count > 0)
                {
                    <div class="mb-2">
                        <span class="text-danger">Manual Resolution Required (@hardErrors.Count)</span>
                        <table class="table table-sm table-dark mb-0 mt-2">
                            <thead>
                                <tr>
                                    <th>Spell</th>
                                    <th>Issue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var issue in hardErrors)
                                {
                                    <tr>
                                        <td>@issue.SpellName</td>
                                        <td><span class="text-danger">No slot configured - add Key or Slot to profile</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @* All Bindings Section *@
        <div class="mt-3 border-top pt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0">All In-Game Bindings (@keyBindingsReader.Count)</h6>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="collapse" data-bs-target="#allBindingsSection">
                    Toggle
                </button>
            </div>
            <div class="collapse" id="allBindingsSection">
                <table class="table table-sm table-dark mb-0">
                    <thead>
                        <tr>
                            <th>Binding ID</th>
                            <th>Keys (click to test)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bindingId in bindings.InGameBindings())
                        {
                            var hasKey1 = keyBindingsReader.TryGetBinding(bindingId, out var key1, out var mod1);
                            var hasKey2 = keyBindingsReader.TryGetSecondaryBinding(bindingId, out var key2, out var mod2);

                            @if (hasKey1 || hasKey2)
                            {
                                <tr>
                                    <td>
                                        <span class="@GetBindingIdClass(bindingId)">@bindingId.ToString()</span>
                                    </td>
                                    <td>
                                        @if (hasKey1)
                                        {
                                            <button class="btn btn-xs btn-outline-info me-1"
                                                    @onclick="() => TestKey(key1, mod1)"
                                                    title="Send @KeyBindingCheck.FormatKey(key1, mod1) to game">
                                                @KeyBindingCheck.FormatKey(key1, mod1)
                                            </button>
                                        }
                                        @if (hasKey2)
                                        {
                                            <button class="btn btn-xs btn-outline-secondary"
                                                    @onclick="() => TestKey(key2, mod2)"
                                                    title="Send @KeyBindingCheck.FormatKey(key2, mod2) to game">
                                                @KeyBindingCheck.FormatKey(key2, mod2)
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
}

<style>
    .keyboard-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .keyboard-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        transform-origin: top left;
    }

    .keyboard-container {
        display: inline-block;
        background: #2d2d2d;
        padding: 10px;
        border-radius: 8px;
        flex-shrink: 0;
    }

    .keyboard-row {
        display: flex;
        gap: 4px;
        margin-bottom: 4px;
    }

    .key {
        min-width: 40px;
        height: 40px;
        background: #404040;
        border: 1px solid #555;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #ccc;
        position: relative;
        cursor: default;
    }

    .key:hover {
        background: #505050;
    }

    .key-binding {
        font-size: 8px;
        color: #aaa;
        max-width: 38px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .key-bound {
        background: #1a5c1a;
        border-color: #2d8a2d;
    }

    .key-mismatch {
        background: #8a2d2d;
        border-color: #b33;
    }

    .key-expected {
        background: #6e5c1a;
        border-color: #b9a029;
    }

    .key-ingame {
        background: #1a4a6e;
        border-color: #2980b9;
    }

    .key-sm { min-width: 35px; }
    .key-wide { min-width: 60px; }
    .key-tab { min-width: 55px; }
    .key-caps { min-width: 65px; }
    .key-enter { min-width: 75px; }
    .key-shift { min-width: 85px; }
    .key-ctrl { min-width: 50px; }
    .key-space { min-width: 200px; }
    .key-nav { min-width: 45px; }
    .key-num { min-width: 40px; }
    .key-num0 { min-width: 84px; }

    /* Action Bar Spell on Key */
    .key-spell {
        font-size: 8px;
        color: #7cb3d9;
        max-width: 38px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .key-action {
        background: #2a4a5e;
        border-color: #3a6a8e;
    }

    .key-ingame-action {
        background: #3a3a5e;
        border-color: #5a5a8e;
    }

    /* Validation states for stance bar slots */
    .key-valid {
        background: #1a5c1a;
        border-color: #2d8a2d;
    }

    .key-empty-warning {
        background: #8a6b1a;
        border-color: #b9a029;
    }

    /* Spell icon on key */
    .key-icon {
        width: 32px;
        height: 32px;
        border-radius: 3px;
        object-fit: cover;
    }

    .key-num .key-icon {
        width: 30px;
        height: 30px;
    }

    .key-sm .key-icon {
        width: 28px;
        height: 28px;
    }

    /* Stance bar styling */
    .stance-bars {
        border-top: 1px solid #444;
        padding-top: 15px;
    }

    .stance-bar-section {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stance-bar-label {
        font-size: 11px;
        color: #aaa;
        padding-left: 10px;
    }

    .key-slot {
        font-size: 10px;
        color: #888;
    }

    .key-slot-empty {
        font-size: 10px;
        color: #555;
    }

    /* Responsive scaling */
    @@media (max-width: 1200px) {
        .keyboard-layout {
            transform: scale(0.85);
        }
        .stance-bars {
            transform: scale(0.85);
            transform-origin: top left;
        }
    }

    @@media (max-width: 992px) {
        .keyboard-layout {
            transform: scale(0.75);
        }
        .stance-bars {
            transform: scale(0.75);
            transform-origin: top left;
        }
    }

    @@media (max-width: 768px) {
        .keyboard-layout {
            transform: scale(0.6);
        }
        .stance-bars {
            transform: scale(0.6);
            transform-origin: top left;
        }
    }

    @@media (max-width: 576px) {
        .keyboard-layout {
            transform: scale(0.45);
        }
        .keyboard-wrapper {
            margin-bottom: -150px; /* Compensate for scaled whitespace */
        }
        .stance-bars {
            transform: scale(0.45);
            transform-origin: top left;
            margin-bottom: -80px;
        }
    }

    @@media (max-width: 400px) {
        .keyboard-layout {
            transform: scale(0.35);
        }
        .keyboard-wrapper {
            margin-bottom: -200px;
        }
        .stance-bars {
            transform: scale(0.35);
            transform-origin: top left;
            margin-bottom: -100px;
        }
    }

    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
        line-height: 1.3;
    }
</style>

@code {
    // Built from the loaded profile; null until one is loaded.
    private KeyBindingCheck? bindings;
    private ActionBarSlotMap? slots;
    private ActionBarPopulator? actionBarPopulator;

    protected override void OnInitialized()
    {
        Subscribe(() => keyBindingsReader.BindingChanged += OnBindingChanged, () => keyBindingsReader.BindingChanged -= OnBindingChanged);
        Subscribe(() => actionBarTextureReader.TextureChanged += OnTextureChanged, () => actionBarTextureReader.TextureChanged -= OnTextureChanged);
        Subscribe(() => botController.ProfileLoaded += OnProfileLoaded, () => botController.ProfileLoaded -= OnProfileLoaded);

        Load();
    }

    private void Load()
    {
        if (botController.ClassConfig is not { } config)
            return;

        bindings = new KeyBindingCheck(keyBindingsReader, BaseActions(config));
        slots = new ActionBarSlotMap(config, playerReader);
        actionBarPopulator = new(
            logFactory.CreateLogger<ActionBarPopulator>(),
            config,
            addonConfigurator,
            bagReader,
            equipmentReader,
            exec);
    }

    private void OnProfileLoaded()
    {
        InvokeAsync(() =>
        {
            Load();
            StateHasChanged();
        });
    }

    private void OnBindingChanged(BindingID bindingId)
    {
        InvokeAsync(() =>
        {
            bindings?.Refresh();
            StateHasChanged();
        });
    }

    private void OnTextureChanged(int slot, int textureId)
    {
        Redraw();
    }

    private static IEnumerable<KeyAction> BaseActions(ClassConfiguration config)
    {
        yield return config.Jump;
        yield return config.Interact;
        yield return config.InteractMouseOver;
        yield return config.Approach;
        yield return config.AutoAttack;
        yield return config.TargetLastTarget;
        yield return config.StandUp;
        yield return config.ClearTarget;
        yield return config.StopAttack;
        yield return config.TargetNearestTarget;
        yield return config.TargetTargetOfTarget;
        yield return config.TargetPet;
        yield return config.PetAttack;
        yield return config.TargetFocus;
        yield return config.FollowTarget;
        yield return config.Mount;
    }

    private List<ActionBarIssue> GetActionBarIssues()
    {
        return botController.ClassConfig is { } config ? actionBarSlotValidator.GetIssues(config) : [];
    }

    private void ResolveActionBarIssue(ActionBarIssue issue)
    {
        if (!issue.CanResolve || issue.Slot <= 0)
            return;

        actionBarPopulator?.Place(issue.KeyAction);
    }

    private void ResolveAllActionBarIssues()
    {
        foreach (ActionBarIssue issue in GetActionBarIssues().Where(i => i.CanResolve).ToList())
        {
            ResolveActionBarIssue(issue);
        }
    }

    private void SyncActionBar()
    {
        actionBarPopulator?.Execute();
    }

    // Sets the default action bar key bindings.
    private void SetupBindings()
    {
        exec.Run($"/{addonConfigurator.Config.CommandBindings}");
    }

    // Creates the custom action buttons (DC_STOPATTACK, DC_CLEARTARGET, DC_FOLLOWTARGET).
    private void SetupActions()
    {
        exec.Run($"/{addonConfigurator.Config.CommandActions}");
    }

    private void TestKey(ConsoleKey key, ModifierKey modifier)
    {
        if (modifier != ModifierKey.None)
        {
            wowInput.PressRandomWithModifier(key, modifier, 50);
        }
        else
        {
            wowInput.PressRandom(key, 50);
        }
    }

    // The key caps render only once a profile is loaded, so bindings and slots are set.

    // A key that presses an action bar slot: the slot's icon, else the key's
    // label and the configured spell (cut to spellLength) or its in-game binding.
    private RenderFragment SlotKey(ConsoleKey key, string label, int slot, string sizeClass, int spellLength) => __builder =>
    {
        KeyAction? action = slots![slot];
        string? iconUrl = GetIconUrl(slot);
        <div class="key @sizeClass @KeyClass(key) @SlotClass(slot, action)" title="@GetCombinedTooltip(key, slot, action)">
            @if (iconUrl != null)
            {
                <img src="@iconUrl" class="key-icon" alt="" />
            }
            else
            {
                <span>@label</span>
                @if (action != null)
                {
                    <div class="key-spell">@TruncateName(action.Name, spellLength)</div>
                }
                else if (bindings!.Label(key) is string binding)
                {
                    <div class="key-binding">@binding</div>
                }
            }
        </div>
    };

    // A key with no action bar slot: its label and its in-game binding.
    private RenderFragment PlainKey(ConsoleKey key, string label, string sizeClass) => __builder =>
    {
        <div class="key @sizeClass @KeyClass(key)" title="@bindings!.Tooltip(key)">
            @label
            @if (bindings.Label(key) is string binding)
            {
                <div class="key-binding">@binding</div>
            }
        </div>
    };

    private string KeyClass(ConsoleKey key) => bindings!.StateOf(key) switch
    {
        KeyBindingState.Bound => "key-bound",       // green: a needed binding, bound
        KeyBindingState.InGame => "key-ingame",     // blue: bound, but not one the bot needs
        KeyBindingState.Unbound => "key-expected",  // yellow: needed here, bound nowhere
        _ => ""
    };

    // A configured action by how its slot checks out; an unconfigured slot by whether the game has something on it.
    private string SlotClass(int slot, KeyAction? action)
    {
        if (action == null)
            return actionBarTextureReader.HasAction(slot) ? "key-ingame-action" : "";

        return actionBarSlotValidator.Validate(action) switch
        {
            SlotValidationStatus.EmptySlot => "key-empty-warning",
            SlotValidationStatus.Mismatch => "key-mismatch",
            SlotValidationStatus.UnknownTexture => "key-action", // an item or a macro
            _ => "key-valid"
        };
    }

    // Base actions without a slot count as valid.
    private static string StatusName(SlotValidationStatus status) => status switch
    {
        SlotValidationStatus.EmptySlot => "Empty",
        SlotValidationStatus.Mismatch => "Mismatch",
        SlotValidationStatus.UnknownTexture => "Unknown",
        _ => "Valid"
    };

    private string GetSlotInfo(KeyAction? action)
    {
        if (action == null)
            return "";

        var parts = new List<string>();

        var cost = actionBarCostReader.Get(action);
        if (cost.Cost > 0)
            parts.Add($"{cost.Cost} {cost.PowerType.ToString()}");

        int cdMs = actionBarCooldownReader.Get(action);
        if (cdMs > 0)
            parts.Add($"CD: {cdMs / 1000f:F1}s");

        if (currentAction.Is(action))
            parts.Add("Active");
        else if (!usableAction.Is(action))
            parts.Add("Not Usable");

        return parts.Count > 0 ? string.Join(", ", parts) : "";
    }

    private string GetCombinedTooltip(ConsoleKey key, int slot, KeyAction? action)
    {
        var parts = new List<string>();

        if (bindings!.TryGetInGame(key, out BindingID primary))
        {
            parts.Add($"Binding: {primary.ToString()}");
        }

        if (action != null)
        {
            parts.Add($"Slot {slot}: {action.Name}");
        }
        else if (slot > 0)
        {
            if (actionBarTextureReader.TryGetTexture(slot, out var textureId))
            {
                parts.Add($"Slot {slot}: In-game (tex:{textureId})");
            }
            else
            {
                parts.Add($"Slot {slot}: Empty");
            }
        }

        string slotInfo = GetSlotInfo(action);
        if (!string.IsNullOrEmpty(slotInfo))
            parts.Add(slotInfo);

        return parts.Count > 0 ? string.Join(" | ", parts) : key.ToString();
    }

    private static string TruncateName(string name, int maxLength)
    {
        if (string.IsNullOrEmpty(name))
            return "";
        return name.Length <= maxLength ? name : name[..maxLength];
    }

    private string GetStanceSlotTooltip(int slot, KeyAction? action)
    {
        var parts = new List<string> { $"Slot {slot}" };

        if (actionBarTextureReader.TryGetTexture(slot, out var textureId) && textureId > 0)
        {
            parts.Add($"Texture: {textureId}");

            var spellNames = iconDB.GetSpellNamesForDisplay(textureId);
            if (spellNames.Length > 0)
            {
                parts.Add($"Spells: {string.Join(", ", spellNames.Take(3))}");
            }
        }

        if (action != null)
        {
            parts.Add($"Config: {action.Name}");
            parts.Add($"Status: {StatusName(actionBarSlotValidator.Validate(action))}");

            string slotInfo = GetSlotInfo(action);
            if (!string.IsNullOrEmpty(slotInfo))
                parts.Add(slotInfo);
        }

        return string.Join(" | ", parts);
    }

    private string? GetIconUrl(int slot)
    {
        if (slot <= 0)
            return null;

        if (!actionBarTextureReader.TryGetTexture(slot, out int textureId) || textureId <= 0)
            return null;

        return iconDB.GetIconUrl(textureId, 36);
    }

    private static string GetBindingIdClass(BindingID bindingId)
    {
        var name = bindingId.ToString();
        if (name.StartsWith("CUSTOM_"))
            return "text-warning";
        if (name.StartsWith("ACTIONBUTTON"))
            return "text-info";
        if (name.StartsWith("MULTIACTIONBAR"))
            return "text-success";
        return "";
    }
}
