@inject IAddonReader addonReader
@inject WowProcessInput wowInput

<Button Color="ButtonColor.Primary" Size="Size" @onpointerup="InitState">
    Init State
</Button>

@code {
    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.None;

    private void InitState()
    {
        addonReader.FullReset();
        wowInput.PressFlushKey();
    }
}
