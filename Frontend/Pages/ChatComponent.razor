@using System.Collections.Specialized

@inherits SubscribingComponentBase

@inject TextReader reader

<Terminal Title="chat" MaxHeight="MaxHeight">
    @foreach (var cme in reader.Messages.Reverse())
    {
        <div class="rig-line @channelCss[(int)cme.Type]">
            <span class="rig-time">@cme.Time.ToString("HH:mm:ss")</span>
            <span class="rig-author">@cme.Author:</span>
            <span class="rig-msg">@cme.Message</span>
        </div>
    }
</Terminal>

@code {
    [Parameter]
    public int MaxHeight { get; set; } = 400;

    // By ChatMessageType: whisper, say, yell, emote, party; site.css colours them.
    private static readonly string[] channelCss = {
        "rig-chat-whisper",
        "rig-chat-say",
        "rig-chat-yell",
        "rig-chat-emote",
        "rig-chat-party",
    };

    protected override void OnInitialized()
    {
        Subscribe(() => reader.Messages.CollectionChanged += Changed, () => reader.Messages.CollectionChanged -= Changed);
    }

    private void Changed(object? s, NotifyCollectionChangedEventArgs e)
    {
        Redraw();
    }
}
