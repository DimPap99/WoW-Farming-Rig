@inject IBotController botController
@inject IAddonReader addonReader

@inherits SubscribingComponentBase

<div class="container">
    <Card>
        <CardHeader>
            Class Configuration
        </CardHeader>
        <CardBody style="padding-bottom: 0">
            <table class="table table-sm table-bordered">
                <tbody>
                    <PropertyRows Target="classConfig" Editable="editable" Hidden="hidden" Changed="Update" />
                </tbody>
            </table>

            @for (int i = 0; i < classConfig.Paths.Length; i++)
            {
                PathSettings path = classConfig.Paths[i];
                <table class="table table-sm table-bordered caption-top">
                    <caption>Path @(i + 1): @path.DisplayName</caption>
                    <tbody>
                        <PropertyRows Target="path" Editable="pathEditable" Hidden="pathHidden" Changed="Update" />
                    </tbody>
                </table>
            }
        </CardBody>
    </Card>
</div>

@code {

    private ClassConfiguration classConfig = null!;

    private static readonly HashSet<string> editable =
    [
        // Int
        nameof(ClassConfiguration.NPCMaxLevels_Above),
        nameof(ClassConfiguration.NPCMaxLevels_Below),
        // booleans
        nameof(ClassConfiguration.Mail),
        nameof(ClassConfiguration.Skin),
        nameof(ClassConfiguration.Mine),
        nameof(ClassConfiguration.Herb),
        nameof(ClassConfiguration.Salvage),
        nameof(ClassConfiguration.Loot),
        nameof(ClassConfiguration.LogBagChanges),
        nameof(ClassConfiguration.UseMount),
        nameof(ClassConfiguration.KeyboardOnly),
        nameof(ClassConfiguration.AllowPvP),
        nameof(ClassConfiguration.AutoPetAttack),
        nameof(ClassConfiguration.CheckTargetGivesExp),
    ];

    // The pre-PathSettings path fields; each path below shows its own.
    private static readonly HashSet<string> hidden =
    [
        nameof(ClassConfiguration.PathThereAndBack),
        nameof(ClassConfiguration.PathReduceSteps),
        nameof(ClassConfiguration.PathFilename),
        nameof(ClassConfiguration.OverridePathFilename),
    ];

    private static readonly HashSet<string> pathEditable =
    [
        nameof(PathSettings.PathThereAndBack),
        nameof(PathSettings.PathReduceSteps),
    ];

    private static readonly HashSet<string> pathHidden = [nameof(PathSettings.FileName)];

    protected override void OnInitialized()
    {
        RefreshData();

        Subscribe(() => botController.ProfileLoaded += RefreshData, () => botController.ProfileLoaded -= RefreshData);
        Subscribe(() => addonReader.AddonDataChanged += Redraw, () => addonReader.AddonDataChanged -= Redraw);
    }

    private void RefreshData()
    {
        classConfig = botController.ClassConfig!;
    }

    private void Update()
    {
        botController.OverrideClassConfig(classConfig);
    }
}
