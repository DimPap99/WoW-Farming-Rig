@page "/AddonConfiguration"

@inject ILogger logger
@inject NavigationManager navigationManager
@inject AddonConfigurator addonConfigurator
@inject ExecGameCommand exec
@inject WowProcess process

@inherits SubscribingComponentBase

<div class="container mt-3">
    <div class="card">
        <div class="card-header">
            Addon Configuration - (@(AddonConfigMeta.DefaultFileName)) file @(AddonConfig.Exists() ? "exists" : "not exists") and @(!addonConfig.IsDefault() ? "valid" : "not valid")
        </div>
        <div class="card-body" style="padding-bottom: 0">
            <table class="table table-bordered">
                <tbody>
                    <PropertyRows Target="addonConfig" Editable="@(addonConfigurator.Installed() ? none : editable)" Hidden="hidden" />
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="container mt-3">
    <div class="card">
        <div class="card-header">
            Addon Control panel
        </div>
        <div class="card-body" style="padding-bottom: 0">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <td style="width:25%">Status</td>
                        <td>
                            <label class="form-control" disabled>
                                @AddonStatus()
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td>Install path</td>
                        <td>
                            <input value="@addonConfigurator.FinalAddonPath" class="form-control" disabled="true" />
                        </td>
                    </tr>
                    <tr>
                        <td>Install / Update addon and config</td>
                        <td>
                            <button class="btn btn-sm btn-success" @onclick="Install">
                                <span>Save</span>
                            </button>
                        </td>
                    </tr>
                    @if (AddonConfig.Exists())
                    {
                        <tr>
                            <td>Delete current addon and config</td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="Delete">
                                    <span>Delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <hr />
    <LogComponent />
</div>


@code {

    private AddonConfig addonConfig = null!;

    // Install makes Command from Title (AddonConfigurator.Validate), and the
    // other commands from Command; nothing is edited once the addon is installed.
    private static readonly HashSet<string> editable =
        [nameof(AddonConfig.Author), nameof(AddonConfig.CellSize), nameof(AddonConfig.Title)];
    private static readonly HashSet<string> none = [];
    private static readonly HashSet<string> hidden = [nameof(AddonConfig.Version)];

    protected override void OnInitialized()
    {
        Subscribe(() => addonConfigurator.OnChange += Redraw, () => addonConfigurator.OnChange -= Redraw);
        addonConfig = addonConfigurator.Config;
    }

    private void Delete()
    {
        addonConfigurator.Delete();
        exec.Run("/reload");

        if (FrameConfig.Exists())
        {
            navigationManager.NavigateTo("/RestartServer");
        }
        else
        {
            navigationManager.NavigateTo("/", true);
        }
    }

    private void Install()
    {
        if (addonConfigurator.Validate())
        {
            addonConfigurator.Install();
            addonConfigurator.Save();

            exec.Run("/reload");

            navigationManager.NavigateTo("/FrameConfiguration");
        }
    }

    private MarkupString AddonStatus()
    {
        if (AddonConfig.Exists() && addonConfigurator.Installed())
        {
            if (addonConfigurator.UpdateAvailable())
            {
                return new("<p class=\"text-warning\">Update available</p>");
            }
            else
            {
                return new("<p class=\"text-success\">Up to Date</p>");
            }
        }

        return new("<p class=\"text-danger\">Not Installed</p>");
    }
}
