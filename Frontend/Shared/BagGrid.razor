@using Frontend.Pages

@inherits SubscribingComponentBase

@inject BagReader bagReader

@* The bags side by side, last bag first, one row per slot. *@
<table class="table table-sm table-striped table-no-border">
    <thead>
        <tr>
            @for (int i = bagReader.Bags.Length - 1; i >= 0; i--)
            {
                <th>
                    <ItemComponent Item="bagReader.Bags[i].Item" />
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @for (int slot = 0; slot <= bagReader.BagMaxSlot(); slot++)
        {
            <tr>
                @for (int bag = bagReader.Bags.Length - 1; bag >= 0; bag--)
                {
                    <td width="20%">
                        @if (Find(bag, slot) is BagItem bagItem)
                        {
                            @if (ChildContent is null)
                            {
                                <ItemComponent Item="bagItem.Item"
                                               Count="bagItem.Count"
                                               LastCount="bagItem.LastCount"
                                               LastChange="bagItem.LastChange"
                                               LastUpdated="bagItem.LastUpdated" />
                            }
                            else
                            {
                                @ChildContent(bagItem)
                            }
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    /// <summary>What a filled slot shows; by default the item, its count and its latest change.</summary>
    [Parameter]
    public RenderFragment<BagItem>? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        Subscribe(() => bagReader.DataChanged += Redraw, () => bagReader.DataChanged -= Redraw);
    }

    private BagItem? Find(int bag, int slot)
    {
        return bagReader.BagItems.FirstOrDefault(b => b.Bag == bag && b.Slot == slot);
    }
}
