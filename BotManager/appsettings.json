{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  // Rolling log beside the service; an empty value turns the file off.
  "LogFile": "out.log",
  "AllowedHosts": "*",
  // Bots, their assignments and run history: JSON files in this folder, beside the service unless rooted.
  "Data": "data"
  // Agents on other PCs need a key: set "ApiKey" (here, or the ApiKey environment variable) to the
  // same value on every service and agent before listening beyond localhost (--urls=http://0.0.0.0:5030).
}
