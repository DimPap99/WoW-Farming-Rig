<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Bot Manager (docs/service-architecture.md): the registry of bots, their assignments and
       run history, the hub agents dial out to, and the live state fanned out to the Control Center.
       Plain net10.0. It references Contracts and ServiceClients only: never Core, Game, WinAPI,
       Frontend or PPather - it knows bots by what they report, not by playing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceHosting\ServiceHosting.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\ServiceClients\ServiceClients.csproj" />
  </ItemGroup>

</Project>
