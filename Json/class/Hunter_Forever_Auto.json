{
  // Level 7 Troll Hunter without a pet, for the guarded Forever runtime: the
  // same shared behaviour as the Paladin profile. Serpent Sting from range
  // aggroes the mob and STARTATTACK starts the auto attack; Raptor Strike
  // resolves on the melee swing once the mob is in contact.
  // Known limitation: the beta reports Raptor Strike's slot in range at any
  // distance, and the Attack ability's slot reports no range at all, so there
  // is no melee-reach signal at this level. A mob that never comes into
  // contact (passive, or below a ledge) ends the run on "Raptor Strike success
  // was not confirmed". Aspect of the Monkey is on slot 64, and Forever reads
  // auras and cooldowns for slots 1 to 12 only.
  "Loot": true,
  "UseMount": false,
  "Paths": [],
  "Combat": {
    "Sequence": [
      {
        "Name": "Serpent Sting",
        "SpellId": 1978,
        "Slot": 3,
        "Key": "3",
        "WhenUsable": true,
        // The sting lasts 15 seconds; refresh it no more often than that.
        "Cooldown": 15000,
        "Requirements": ["Spell:1978", "TargetHealth% > 25", "Mana% >= 30"]
      },
      {
        "Name": "Arcane Shot",
        "SpellId": 3044,
        "Slot": 5,
        "Key": "5",
        "WhenUsable": true,
        "Requirements": ["Spell:3044", "TargetHealth% > 0", "Mana% >= 20"]
      },
      { "Name": "AutoAttack" },
      {
        "Name": "Raptor Strike",
        "SpellId": 2973,
        "Slot": 1,
        "Key": "1",
        "WhenUsable": true,
        // Resolves on the next melee swing, which is when its success event arrives.
        "AfterCastWaitSwing": true,
        "Requirements": ["Spell:2973", "TargetHealth% > 0"]
      }
    ]
  }
}
