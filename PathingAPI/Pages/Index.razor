@page "/"
@page "/Watch"

@inject IJSRuntime js
@inject ServerStatus status
@inject WorldMapAreaDB worldMapAreas

@* Watches whatever the API answers - the bot's routes included - so it leaves the
   engine alone when it opens. *@
<Viewport3D ResetOnOpen="false">
    <Panel Title="Test routes" Icon="list" Position="top-left" Class="pa-panel--tall">
        <Actions>
            <span class="pa-count">@shown.Count / @TestRoutes.All.Count</span>
        </Actions>
        <ChildContent>
            <input class="pa-input" type="search" placeholder="Filter by zone or name" aria-label="Filter test routes"
                   @bind="filter" @bind:event="oninput" @bind:after="Refilter" />
            <label class="pa-check" title="Hide routes on continents this install has no navmesh tiles for">
                <input type="checkbox" @bind="onlyRoutable" @bind:after="Refilter" /> Only continents with tiles
            </label>

            <div class="pa-list">
                @foreach (IGrouping<string, TestRoute> zone in shown.GroupBy(r => r.Zone))
                {
                    <div class="pa-list-heading">@zone.Key</div>
                    @foreach (TestRoute route in zone)
                    {
                        bool routable = snapshot.CanRoute(continents[route]);
                        <div class="pa-list-item @(routable ? null : "is-unavailable")"
                             title="@(routable ? route.Url : $"No navmesh tiles for {continents[route] ?? "this map"}")">
                            <span class="pa-list-name">@route.Name</span>
                            <ResultLine Text="@Result(route.Url)" Kind="@Kind(route.Url)" />
                            <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Run"
                                    @onclick="() => RunAsync(route.Url)">
                                <span class="oi oi-media-play" aria-hidden="true"></span>
                            </button>
                            @if (route.ReverseUrl is string reverse)
                            {
                                <button class="pa-btn pa-btn--ghost pa-btn--icon" type="button" title="Run reversed"
                                        @onclick="() => RunAsync(reverse)">
                                    <span class="oi oi-loop-circular" aria-hidden="true"></span>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </ChildContent>
    </Panel>
</Viewport3D>

@code {
    /// <summary>What a test route's call returned, as reported by pathingUi.callApi.</summary>
    private sealed record ApiResult(int Status, int Points, int Ms);

    private readonly Dictionary<TestRoute, string?> continents = [];
    private readonly Dictionary<string, ApiResult?> results = [];

    private StatusSnapshot snapshot = null!;
    private string filter = string.Empty;
    private bool onlyRoutable;
    private List<TestRoute> shown = [];

    protected override void OnInitialized()
    {
        snapshot = status.Read();

        foreach (TestRoute route in TestRoutes.All)
            continents[route] = ContinentOf(route);

        Refilter();
    }

    private void Refilter()
    {
        shown = TestRoutes.All
            .Where(r => filter.Length == 0 ||
                        r.Zone.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                        r.Name.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .Where(r => !onlyRoutable || snapshot.CanRoute(continents[r]))
            .ToList();
    }

    private string? ContinentOf(TestRoute route)
    {
        if (route.MapId is int mapId)
            return ContinentDB.IdToName.GetValueOrDefault(mapId);

        return route.UiMap is int uiMap && worldMapAreas.TryGet(uiMap, out WorldMapArea area)
            ? area.Continent
            : null;
    }

    private async Task RunAsync(string url)
    {
        results[url] = null;
        ApiResult result = await js.InvokeAsync<ApiResult>("pathingUi.callApi", Token, url);
        results[url] = result;
        snapshot = status.Read();
    }

    private string? Result(string url)
    {
        if (!results.TryGetValue(url, out ApiResult? r))
            return null;

        return r switch
        {
            null => "...",
            { Status: 200, Points: > 0 } => $"{r.Points} pts · {r.Ms} ms",
            { Status: 200 } => "no path",
            { Status: 429 } => "busy",
            { Status: 0 } => "offline",
            _ => $"HTTP {r.Status}"
        };
    }

    private ResultKind Kind(string url) => results.GetValueOrDefault(url) switch
    {
        { Status: 200, Points: > 0 } => ResultKind.Ok,
        { Status: 200 or 429 } => ResultKind.Warn,
        null => ResultKind.Info,
        _ => ResultKind.Error
    };
}
