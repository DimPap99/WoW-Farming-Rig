@page "/Leaflet/{expansion?}/{continent?}/{zoom:int?}/{x:float?}/{y:float?}/"

@implements IAsyncDisposable

@inject IJSRuntime js
@inject DataConfig dataConfig

<div class="pa-map">
    <div id="js-map">
        <div class="specText" id="adtClick"></div>
        <div class="specText" id="worldClick"></div>
        <div class="specText" id="mapClick"></div>
        <div class="specText" id="subZoneName"></div>
    </div>

    <Panel Title="Route search" Icon="magnifying-glass" Class="pa-panel--map">
        <SearchPanel @ref="search" Continent="@Continent" Locked="true" />
    </Panel>
</div>

@code {
    // No default era here on purpose: it is overwritten from DataConfig.Exp in
    // OnAfterRenderAsync. A literal default ("som") is what made a bare
    // /Leaflet URL misreport the era on every non-vanilla server.
    [Parameter] public string? expansion { get; set; }
    // Null when the URL has no continent segment, whatever the initialiser says.
    [Parameter] public string? continent { get; set; }
    [Parameter] public int zoom { get; set; } = 4;
    [Parameter] public float x { get; set; }
    [Parameter] public float y { get; set; }

    public const string DefaultContinent = "Azeroth";

    private string Continent => continent ?? DefaultContinent;

    private DotNetObjectReference<Leaflet>? dotNetRef;
    private SearchPanel? search;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The URL's expansion segment is advisory only - the server decides.
        // Every data source this map reads is resolved server-side from
        // DataConfig.Exp (set by --exp): /dbc/* is DataConfig.ExpDbc, /tiles
        // is DataConfig.Leaflet, and the navmesh cache is per era. Honouring a
        // different value from the URL renders one era's minimap art and
        // continent list against another era's areas and navmesh.
        string serverExp = dataConfig.Exp;
        if (!string.IsNullOrEmpty(expansion) &&
            !expansion.Equals(serverExp, StringComparison.OrdinalIgnoreCase))
        {
            await js.InvokeVoidAsync("pathingUi.log",
                $"URL expansion '{expansion}' ignored: this server runs '{serverExp}' (--exp).");
        }
        expansion = serverExp;

        // Handed to the map so custom POIs are mirrored into the search panel. See leaflet-poi.js.
        dotNetRef = DotNetObjectReference.Create(this);

        await js.InvokeVoidAsync("init",
            expansion, Continent,
            zoom, x, y, true,
            NpcFlagsExtensions.ToDictionary(),
            dotNetRef);
    }

    [JSInvokable("AddCustomPoi")]
    public void AddCustomPoi(float x, float y, float z, float mapId, string description)
    {
        search?.AddCustom(new NamedLocation(description, new Vector4(x, y, z, mapId)));
    }

    [JSInvokable("RemoveCustomPoi")]
    public void RemoveCustomPoi(string description)
    {
        search?.RemoveCustom(description);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        // The map, its PIXI overlay and its listeners outlive the element otherwise.
        await js.InvokeTeardownAsync("disposeMap");
        dotNetRef?.Dispose();
    }
}
