@page "/Route"

@inject RecordedPaths recorded
@inject RouteSearch routes
@inject PPatherService service
@inject WorldMapAreaDB worldMapAreas
@inject ServerStatus status

<Viewport3D>
    <Panel Title="Recorded paths" Icon="map-marker">
        <div class="pa-form">
            <div class="pa-field">
                <label class="pa-label" for="pa-path-file">Path file</label>
                <input class="pa-input" id="pa-path-file" list="pa-path-files" autocomplete="off"
                       placeholder="Type to search @files.Count files" @bind="file" @bind:after="FileChosen" />
                <datalist id="pa-path-files">
                    @foreach (string f in files)
                    {
                        <option value="@f"></option>
                    }
                </datalist>
            </div>

            @if (thumbnail != null)
            {
                <a class="pa-thumb" href="@thumbnail" target="_blank" title="Screenshot saved with the recording">
                    <img src="@thumbnail" alt="Screenshot of @file" loading="lazy" />
                </a>
            }

            <div class="pa-field">
                <label class="pa-label" for="pa-path-zone" title="Converts zone coordinates to world ones and picks the continent">Zone</label>
                <select class="pa-select" id="pa-path-zone" @bind="uiMap">
                    <option value="0" disabled>Choose a zone</option>
                    @foreach (WorldMapArea area in zones)
                    {
                        <option value="@area.UIMapId">@area.AreaName (@area.Continent)</option>
                    }
                </select>
            </div>

            <BusyButton Class="pa-btn--primary" Icon="eye" Busy="@busy" Disabled="@(file.Length == 0 || uiMap == 0)" OnClick="DrawAsync">
                Load and draw
            </BusyButton>

            @if (points.Length > 1)
            {
                <div class="pa-divider"></div>
                <div class="pa-field">
                    <span class="pa-label">Leg to search (of @points.Length points)</span>
                    <div class="pa-stepper">
                        <button class="pa-btn pa-btn--icon" type="button" title="Previous leg" @onclick="() => Step(-1)">
                            <span class="oi oi-chevron-left" aria-hidden="true"></span>
                        </button>
                        <input class="pa-input" type="number" min="0" max="@(points.Length - 1)" aria-label="Start point" @bind="Start" />
                        <span class="pa-faint">to</span>
                        <input class="pa-input" type="number" min="0" max="@(points.Length - 1)" aria-label="End point" @bind="End" />
                        <button class="pa-btn pa-btn--icon" type="button" title="Next leg" @onclick="() => Step(1)">
                            <span class="oi oi-chevron-right" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>

                @if (snapshotEngine == PathingEngine.SpotAStar)
                {
                    <div class="pa-field">
                        <label class="pa-label" for="pa-path-strategy">Strategy</label>
                        <StrategySelect Id="pa-path-strategy" @bind-Value="strategy" />
                    </div>
                }

                <BusyButton Class="pa-btn--primary" Icon="media-play" Busy="@busy" OnClick="SearchLegAsync">
                    Search leg
                </BusyButton>
            }

            <ResultLine Text="@result" Kind="@resultKind" />
        </div>
    </Panel>
</Viewport3D>

@code {
    private IReadOnlyList<string> files = [];
    private WorldMapArea[] zones = [];

    private string file = string.Empty;
    private string? thumbnail;
    private int uiMap;
    private float mapId;
    private Vector3[] points = [];
    private int start;
    private int end = 1;
    private SearchStrategy strategy = RouteSearch.DefaultStrategy;
    private PathingEngine snapshotEngine;
    private bool busy;
    private string? result;
    private ResultKind resultKind;

    private int Start
    {
        get => start;
        set => start = Clamp(value);
    }

    private int End
    {
        get => end;
        set => end = Clamp(value);
    }

    private int Clamp(int index) => Math.Clamp(index, 0, Math.Max(0, points.Length - 1));

    protected override void OnInitialized()
    {
        files = recorded.Files();
        zones = worldMapAreas.Values.OrderBy(w => w.AreaName).ToArray();
        snapshotEngine = status.Read().Engine;
    }

    private void FileChosen()
    {
        thumbnail = null;
        if (!files.Contains(file))
            return;

        thumbnail = recorded.Thumbnail(file);
        if (recorded.GuessZone(file) is WorldMapArea zone)
            uiMap = zone.UIMapId;
    }

    private async Task DrawAsync()
    {
        if (!files.Contains(file) || !worldMapAreas.TryGet(uiMap, out WorldMapArea zone) ||
            !ContinentDB.NameToId.TryGetValue(zone.Continent, out mapId))
        {
            Show("Choose a path file and its zone.", ResultKind.Error);
            return;
        }

        busy = true;
        try
        {
            Vector3[] read = recorded.Read(file);
            int zoneMap = uiMap;

            // Zone coordinates get their world position (and a height) from the engine,
            // each point guessing its z from the one before.
            bool converted = await routes.RunAsync(() =>
            {
                if (!read.All(p => p.Z == 0))
                    return;

                float lastZ = 0;
                for (int i = 0; i < read.Length; i++)
                {
                    read[i] = service.ToWorld(zoneMap, read[i].X, read[i].Y, lastZ).AsVector3();
                    lastZ = read[i].Z;
                }
            }, Token);

            if (!converted)
                return;

            points = read;
            start = 0;
            end = Clamp(1);

            await routes.DrawAsync(mapId, points, PathStyle.Draft, Token);
            Show($"{points.Length} points on {zone.Continent}", ResultKind.Ok);
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Show(e.Message, ResultKind.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private void Step(int by)
    {
        if (start + by < 0 || end + by > points.Length - 1)
            return;

        start += by;
        end += by;
    }

    private async Task SearchLegAsync()
    {
        busy = true;
        Show($"Searching {start} to {end}...", ResultKind.Info);
        try
        {
            SearchOutcome outcome = await routes.FindAsync(
                new Vector4(points[start], mapId), new Vector4(points[end], mapId), strategy, default, Token);
            Show($"Leg {start}-{end}: {outcome.Summary}",
                outcome.Error != null ? ResultKind.Error : outcome.Found ? ResultKind.Ok : ResultKind.Warn);
        }
        finally
        {
            busy = false;
        }
    }

    private void Show(string text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }
}
