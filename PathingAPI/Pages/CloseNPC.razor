@page "/CloseNPC"

@using Core.Database

@inject AreaDB areaDB
@inject RouteSearch routes
@inject PPatherService service
@inject WatchBroadcaster watch
@inject WorldMapAreaDB worldMapAreas
@inject ServerStatus status

<Viewport3D>
    <Panel Title="NPC routes" Icon="people">
        <div class="pa-form">
            <div class="pa-field">
                <label class="pa-label" for="pa-npc-zone">Zone</label>
                <select class="pa-select" id="pa-npc-zone" value="@uiMap" @onchange="ZoneChosen">
                    <option value="0" disabled>Choose a zone</option>
                    @foreach (WorldMapArea area in zones)
                    {
                        <option value="@area.UIMapId">@area.AreaName (@area.Continent)</option>
                    }
                </select>
            </div>

            <div class="pa-row">
                <div class="pa-field">
                    <label class="pa-label" for="pa-npc-type">Type</label>
                    <select class="pa-select" id="pa-npc-type" value="@type" @onchange="TypeChosen">
                        @foreach (NpcFlags flag in Types)
                        {
                            <option value="@flag">@flag</option>
                        }
                    </select>
                </div>
                <div class="pa-field pa-grow2">
                    <label class="pa-label" for="pa-npc-name">NPC</label>
                    <select class="pa-select" id="pa-npc-name" @bind="npcEntry" disabled="@(npcs.Count == 0)">
                        @if (npcs.Count == 0)
                        {
                            <option value="0">@(uiMap == 0 ? "Choose a zone first" : loading ? "Loading..." : "None in this zone")</option>
                        }
                        @foreach ((int entry, string name) in npcs)
                        {
                            <option value="@entry">@name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="pa-field">
                <span class="pa-label">Start</span>
                <div class="pa-input-group">
                    <span class="pa-input pa-readout">@(start is Vector3 s ? $"{s.X:F0}, {s.Y:F0}, {s.Z:F0}" : "Random point in the zone")</span>
                    <button class="pa-btn" type="button" disabled="@(uiMap == 0)" @onclick="RandomStartAsync" title="Pick a random point in the zone">
                        <span class="oi oi-random" aria-hidden="true"></span> Roll
                    </button>
                </div>
            </div>

            <label class="pa-check"><input type="checkbox" @bind="reversed" /> From the NPC back to the start</label>

            @if (engine == PathingEngine.SpotAStar)
            {
                <div class="pa-field">
                    <label class="pa-label" for="pa-npc-strategy">Strategy</label>
                    <StrategySelect Id="pa-npc-strategy" @bind-Value="strategy" />
                </div>
            }

            <div class="pa-actions">
                <button class="pa-btn" type="button" disabled="@(!Ready || busy)" @onclick="DrawAsync" title="Straight line to the NPC">
                    <span class="oi oi-minus" aria-hidden="true"></span> Line
                </button>
                <BusyButton Class="pa-btn--primary pa-grow" Icon="media-play" Busy="@busy" Disabled="@(!Ready)" OnClick="FindAsync">
                    Find path
                </BusyButton>
            </div>

            <ResultLine Text="@result" Kind="@resultKind" />
        </div>
    </Panel>
</Viewport3D>

@code {
    private const float MapMargin = 20f;    // keep random starts off the zone's edge
    private const float MapSpan = 70f;

    private static readonly NpcFlags[] Types = Enum.GetValues<NpcFlags>().Where(f => f != NpcFlags.None).ToArray();

    private WorldMapArea[] zones = [];
    private List<(int Entry, string Name)> npcs = [];

    private int uiMap;
    private float mapId;
    private NpcFlags type = NpcFlags.Vendor;
    private int npcEntry;
    private Vector3? start;
    private bool reversed;
    private bool loading;
    private SearchStrategy strategy = RouteSearch.DefaultStrategy;
    private PathingEngine engine;
    private bool busy;
    private string? result;
    private ResultKind resultKind;

    private bool Ready => start.HasValue && NpcPosition() is not null;

    protected override void OnInitialized()
    {
        zones = worldMapAreas.Values.OrderBy(w => w.AreaName).ToArray();
        engine = status.Read().Engine;

        Subscribe(() => areaDB.Changed += AreaLoaded, () => areaDB.Changed -= AreaLoaded);
    }

    private void ZoneChosen(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int chosen) || !worldMapAreas.TryGet(chosen, out WorldMapArea zone))
            return;

        uiMap = chosen;
        mapId = ContinentDB.NameToId.GetValueOrDefault(zone.Continent);
        start = null;

        // AreaDB is shared and ignores the area it already holds - no Changed follows.
        if (areaDB.CurrentWorldMapArea?.AreaID == zone.AreaID)
        {
            ListNpcs();
            return;
        }

        npcs = [];
        loading = true;
        areaDB.Update(zone.AreaID);
    }

    private void TypeChosen(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out NpcFlags chosen))
        {
            type = chosen;
            ListNpcs();
        }
    }

    // AreaDB loads on its own thread.
    private void AreaLoaded()
    {
        loading = false;
        ListNpcs();
        Redraw();
    }

    /// <summary>NPCs of the chosen type whose first spawn lies inside the zone.</summary>
    private void ListNpcs()
    {
        List<(int, string)> found = [];
        if (areaDB.Hitbox is WorldMapArea hitbox)
        {
            foreach (Creature npc in areaDB.GetByNpcFlag(type))
            {
                if (string.IsNullOrEmpty(npc.Name) || !areaDB.NpcWorldLocations.TryGetValue(npc.Entry, out Vector3[]? spawns))
                    continue;

                Vector3 map = WorldMapAreaDB.ToMap_FlipXY(spawns[0], hitbox);
                if (map.X is > 0 and < 100 && map.Y is > 0 and < 100)
                    found.Add((npc.Entry, npc.Name));
            }
        }

        npcs = found.OrderBy(n => n.Item2).ToList();
        npcEntry = npcs.Count > 0 ? npcs[0].Entry : 0;
    }

    private Vector3? NpcPosition() =>
        areaDB.NpcWorldLocations.TryGetValue(npcEntry, out Vector3[]? spawns) && spawns.Length > 0 ? spawns[0] : null;

    private async Task RandomStartAsync()
    {
        float x = Random.Shared.NextSingle() * MapSpan + MapMargin;
        float y = Random.Shared.NextSingle() * MapSpan + MapMargin;
        int zone = uiMap;

        Vector4 world = default;
        if (!await routes.RunAsync(() => world = service.ToWorld(zone, x, y), Token))
            return;

        start = world.AsVector3();
        watch.ShowMarker("startSphere", start.Value, WatchColor.Teal);
        Show($"Start at map {x:F1}, {y:F1}", ResultKind.Info);
    }

    private (Vector3 From, Vector3 To) Endpoints()
    {
        Vector3 npc = NpcPosition()!.Value;
        return reversed ? (npc, start!.Value) : (start!.Value, npc);
    }

    private async Task DrawAsync()
    {
        (Vector3 from, Vector3 to) = Endpoints();
        try
        {
            await routes.DrawAsync(mapId, [from, to], PathStyle.Draft, Token);
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Show(e.Message, ResultKind.Error);
        }
    }

    private async Task FindAsync()
    {
        (Vector3 from, Vector3 to) = Endpoints();
        busy = true;
        Show("Searching...", ResultKind.Info);
        try
        {
            SearchOutcome outcome = await routes.FindAsync(new Vector4(from, mapId), new Vector4(to, mapId), strategy, default, Token);
            Show(outcome.Summary, outcome.Error != null ? ResultKind.Error : outcome.Found ? ResultKind.Ok : ResultKind.Warn);
        }
        finally
        {
            busy = false;
        }
    }

    private void Show(string text, ResultKind kind)
    {
        result = text;
        resultKind = kind;
    }
}
