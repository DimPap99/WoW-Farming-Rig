@page "/"
@namespace PathingAPI.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>PathingAPI</title>
    <base href="~/" />

    @* Bootstrap stays for the map: its sidebar and controls are Bootstrap-styled. *@
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />

    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />

    <script src="_content/Frontend/leaflet-groupedlayercontrol/leaflet.groupedlayercontrol.min.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="_content/Frontend/leaflet-groupedlayercontrol/leaflet.groupedlayercontrol.min.css" />

    <link rel="stylesheet" href="_content/Frontend/leaflet/leaflet.draw.css" />
    <link rel="stylesheet" href="_content/Frontend/css/leaflet-sidebar.css" />
    <link rel="stylesheet" href="_content/Frontend/css/leaflet-map.css" asp-append-version="true" />
    <script src="_content/Frontend/leaflet/leaflet.draw.js" asp-append-version="true"></script>

    <script src="_content/Frontend/leaflet-pixi/pixi.min.js" asp-append-version="true"></script>
    <script src="_content/Frontend/leaflet-pixi/PixiOverlay.js" asp-append-version="true"></script>

    <script src="_content/Frontend/script/icon_atlas.js" asp-append-version="true"></script>
    @* The map, in pieces and in this order: see scripts/leaflet-pieces.mjs. *@
    <script src="_content/Frontend/script/leaflet-watch.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-map.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-layers.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-coords.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-spawns.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-sidebar.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-paths.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-signalr.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-zones.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-poi.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-navmesh.js" asp-append-version="true"></script>
    <script src="_content/Frontend/script/leaflet-bake.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>

    <div id="blazor-error-ui" role="alert">
        <environment include="Staging,Production">
            An error has occurred. This page may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See the browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss" aria-label="Dismiss">✕</a>
    </div>

    <script src="_framework/blazor.server.js"></script>

    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/signalr-protocol-msgpack.min.js"></script>

    @* The 3D view fetches Babylon.js itself, and only on the pages that have one. *@
    <script src="~/js/pathing-ui.js" asp-append-version="true"></script>
    <script src="~/js/pathing-scene.js" asp-append-version="true"></script>
</body>
</html>
