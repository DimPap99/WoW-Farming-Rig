<nav class="pa-nav">
    @foreach (NavSection group in Sections)
    {
        <div class="pa-nav-section">@group.Title</div>
        @foreach (NavItem item in group.Items)
        {
            <NavLink class="pa-nav-link" href="@item.Href" Match="@item.Match" title="@item.Hint">
                <span class="oi oi-@item.Icon" aria-hidden="true"></span>
                <span class="pa-nav-label">@item.Label</span>
            </NavLink>
        }
    }
</nav>

@code {
    private sealed record NavItem(string Label, string Href, string Icon, string Hint,
        NavLinkMatch Match = NavLinkMatch.Prefix);

    private sealed record NavSection(string Title, NavItem[] Items);

    private static readonly NavSection[] Sections =
    [
        new("Views",
        [
            new("Live view", "", "pulse", "3D view of every search the API answers, plus test routes", NavLinkMatch.All),
            new("Map", "Leaflet", "map", "The minimap with spawns, zones, navmesh coverage and bakes"),
        ]),
        new("Tools",
        [
            new("Route search", "Search", "magnifying-glass", "Search between named places"),
            new("Recorded paths", "Route", "map-marker", "Replay a recorded grind path and search its legs"),
            new("NPC routes", "CloseNPC", "people", "Route to the nearest NPC of a type"),
        ]),
        new("Reference",
        [
            new("API", "SwaggerFrame", "code", "Swagger: every endpoint, with examples"),
        ]),
    ];
}
