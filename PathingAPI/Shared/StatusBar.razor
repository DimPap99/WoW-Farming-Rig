@inject ServerStatus status
@inject PatherGate gate
@inject RouteSearch routes

<header class="pa-statusbar">
    <span class="pa-chip" title="Client data (--exp) and the geometry era its tiles come from">
        <span class="oi oi-globe" aria-hidden="true"></span>
        <strong>@snapshot.Exp</strong><span class="pa-faint">@snapshot.Era</span>
    </span>

    <label class="pa-chip pa-chip--select" title="Pathfinding engine. Switching drops the engine's resident tiles.">
        <span class="pa-faint">Engine</span>
        <select value="@snapshot.Engine" @onchange="SwitchEngine" disabled="@switching">
            @foreach (PathingEngine engine in Enum.GetValues<PathingEngine>())
            {
                <option value="@engine">@engine</option>
            }
        </select>
    </label>

    @if (snapshot.Engine == PathingEngine.Navmesh)
    {
        @if (snapshot.Tiles > 0)
        {
            <span class="pa-chip pa-chip--ok" title="@CoverageTitle">
                <span class="pa-dot" aria-hidden="true"></span>
                <strong>@snapshot.Tiles.ToString("N0")</strong> tiles
                <span class="pa-faint">@string.Join(", ", snapshot.ContinentsWithTiles)</span>
            </span>
        }
        else
        {
            <span class="pa-chip pa-chip--warn" title="@CoverageTitle">
                <span class="pa-dot" aria-hidden="true"></span>
                No navmesh tiles for @snapshot.Era: run <code>scripts/download-navmesh.ps1</code>
            </span>
        }
    }

    @if (snapshot.Bake.Running)
    {
        <span class="pa-chip pa-chip--busy" title="@snapshot.Bake.Message">
            <span class="pa-dot" aria-hidden="true"></span>
            Baking <strong>@snapshot.Bake.Continent</strong>
            <span class="pa-meter" aria-hidden="true"><span style="width: @BakePercent"></span></span>
            <span class="pa-faint">@snapshot.Bake.AdtDone / @snapshot.Bake.AdtTotal ADT</span>
        </span>
    }

    <span class="pa-spacer"></span>

    @if (snapshot.LastQueryPoints > 0)
    {
        <span class="pa-chip" title="The engine's last route: time spent loading tiles, resolving, searching and smoothing">
            <span class="pa-faint">Last route</span>
            <strong>@snapshot.LastQueryMs.ToString("F0", CultureInfo.InvariantCulture) ms</strong>
            <span class="pa-faint">@snapshot.LastQueryPoints pts</span>
        </span>
    }

    <span class="pa-chip @(snapshot.Busy ? "pa-chip--busy" : null)"
          title="One search runs at a time; HTTP callers get 429 while it does, AnTCP and this UI wait">
        <span class="pa-dot" aria-hidden="true"></span>
        @(snapshot.Busy ? "Searching" : "Idle")
    </span>
</header>

@code {
    private const int RefreshMs = 1000;

    private StatusSnapshot snapshot = null!;
    private bool switching;

    private string CoverageTitle => string.Join("\n",
        snapshot.Coverage.Select(c => $"{c.Continent}: {c.Tiles:N0} tiles ({c.Hash})"));

    private string BakePercent => snapshot.Bake.AdtTotal > 0
        ? (100.0 * snapshot.Bake.AdtDone / snapshot.Bake.AdtTotal).ToString("F1", CultureInfo.InvariantCulture) + "%"
        : "0%";

    protected override void OnInitialized()
    {
        snapshot = status.Read();

        Subscribe(() => gate.BusyChanged += Refresh, () => gate.BusyChanged -= Refresh);

        Timer timer = new(_ => Refresh(), null, RefreshMs, RefreshMs);
        OnDispose(timer.Dispose);
    }

    // Queued onto this circuit, not run here: the gate raises BusyChanged on the
    // searching thread while it holds the gate, and Read() may walk the tile cache.
    private void Refresh() => _ = InvokeAsync(() =>
    {
        snapshot = status.Read();
        StateHasChanged();
    });

    private async Task SwitchEngine(ChangeEventArgs e)
    {
        if (!Enum.TryParse(e.Value?.ToString(), out PathingEngine engine) || engine == snapshot.Engine)
            return;

        switching = true;
        try
        {
            await routes.SetEngineAsync(engine, Token);
            status.Invalidate();
            snapshot = status.Read();
        }
        finally
        {
            switching = false;
        }
    }
}
