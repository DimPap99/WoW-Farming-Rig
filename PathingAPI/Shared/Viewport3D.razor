@* The 3D view: a Babylon canvas fed by the watch hub, its toolbar, and whatever
   panels the page puts on top. *@

@implements IAsyncDisposable

@inject IJSRuntime js
@inject WatchSettings settings
@inject WatchBroadcaster watch
@inject RouteSearch routes
@inject DataConfig dataConfig

<div class="pa-viewport">
    <canvas class="pa-canvas" @ref="canvas" tabindex="0" aria-label="3D route view"></canvas>

    <div class="pa-toolbar">
        <div class="pa-group" role="group" aria-label="Layers in this view">
            <span class="pa-group-label" title="What this tab shows">Show</span>
            @foreach ((TriangleType layer, string label) in Layers)
            {
                <button class="pa-toggle" type="button" aria-pressed="@(!hidden.Contains(layer))" @onclick="() => ToggleLayer(layer)">@label</button>
            }
            <button class="pa-toggle" type="button" aria-pressed="@wireframe" @onclick="ToggleWireframe">Wireframe</button>
        </div>

        <div class="pa-group" role="group" aria-label="What the server streams">
            <span class="pa-group-label" title="What the server sends to every viewer">Stream</span>
            <button class="pa-toggle" type="button" aria-pressed="@settings.NavmeshTiles"
                    title="Navmesh tiles as the engine loads them"
                    @onclick="() => settings.SetNavmeshTiles(!settings.NavmeshTiles)">Navmesh</button>
            <label class="pa-toggle pa-toggle--select" title="Client geometry around a search (needs game archives)">
                Geometry
                <select value="@settings.Geometry" @onchange="SetGeometry">
                    @foreach ((GeometryMode mode, string label) in GeometryModes)
                    {
                        <option value="@mode">@label</option>
                    }
                </select>
            </label>
            <button class="pa-toggle" type="button" aria-pressed="@settings.TestPoints"
                    title="SpotAStar's explored and blocked points"
                    @onclick="() => settings.SetTestPoints(!settings.TestPoints)">Test points</button>
        </div>

        <span class="pa-spacer"></span>

        <div class="pa-group" role="group" aria-label="Scene actions">
            <button class="pa-toggle" type="button" aria-pressed="@inspector" @onclick="ToggleInspector"
                    title="Babylon's scene inspector">Inspector</button>
            <button class="pa-toggle" type="button" @onclick="ResetAsync"
                    title="Clear every viewer's scene and drop the engine's resident tiles">
                <span class="oi oi-reload" aria-hidden="true"></span> Reset
            </button>
            <button class="pa-toggle pa-toggle--danger" type="button" @onclick="ClearSpotCacheAsync"
                    title="Delete the legacy engine's spot cache (navmesh tiles are kept)">Clear spot cache</button>
        </div>
    </div>

    @ChildContent

    <div class="pa-hint" aria-hidden="true">
        <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> move
        <kbd>Q</kbd><kbd>E</kbd> down / up
        <kbd>Shift</kbd> fast <kbd>Alt</kbd> slow · drag to look
    </div>
</div>

@code {
    private static readonly (TriangleType Layer, string Label)[] Layers =
    [
        (TriangleType.Terrain, "Terrain"),
        (TriangleType.Water, "Water"),
        (TriangleType.Object, "Objects"),
        (TriangleType.Model, "Models"),
    ];

    private static readonly (GeometryMode Mode, string Label)[] GeometryModes =
    [
        (GeometryMode.Off, "Off"),
        (GeometryMode.SparseFromSpots, "Explored"),
        (GeometryMode.WalkableOnly, "Walkable"),
        (GeometryMode.ExploredArea, "Area"),
        (GeometryMode.All, "All"),
    ];

    /// <summary>Panels shown over the view.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Drops the engine's resident state when the view opens, so every chunk and
    /// tile is streamed to it afresh. Off for a view that only watches.
    /// </summary>
    [Parameter] public bool ResetOnOpen { get; set; } = true;

    private ElementReference canvas;
    private readonly HashSet<TriangleType> hidden = [];
    private bool wireframe;
    private bool inspector;

    protected override void OnInitialized()
    {
        Subscribe(() => settings.Changed += Redraw, () => settings.Changed -= Redraw);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            if (await js.InvokeAsync<bool>("pathingScene.create", Token, canvas) && ResetOnOpen)
                await routes.ResetAsync(Token);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Left before the scene was up, or Babylon could not be fetched.
        }
    }

    private async Task ToggleLayer(TriangleType layer)
    {
        if (!hidden.Remove(layer))
            hidden.Add(layer);

        await Js("pathingScene.toggleLayer", (int)layer);
    }

    private async Task ToggleWireframe()
    {
        wireframe = !wireframe;
        await Js("pathingScene.setWireframe", wireframe);
    }

    private async Task ToggleInspector()
    {
        inspector = !inspector;
        await Js("pathingScene.setInspector", inspector);
    }

    private void SetGeometry(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out GeometryMode mode))
            settings.SetGeometry(mode);
    }

    private async Task ResetAsync()
    {
        watch.Clear();
        await routes.ResetAsync(Token);
        watch.Log("Scene and engine reset");
    }

    private async Task ClearSpotCacheAsync()
    {
        if (!await js.InvokeAsync<bool>("confirm", Token,
            $"Delete the spot cache under {dataConfig.PathInfo}? Navmesh tiles are kept."))
            return;

        try
        {
            if (await routes.RunAsync(dataConfig.DeletePPatherCache, Token))
                watch.Log("Spot cache cleared; navmesh tiles kept");
        }
        catch (Exception e) when (e is System.IO.IOException or UnauthorizedAccessException)
        {
            watch.Log("Could not clear the spot cache: " + e.Message);
        }
    }

    private async Task Js(string identifier, params object[] args)
    {
        try
        {
            await js.InvokeVoidAsync(identifier, Token, args);
        }
        catch (Exception e) when (e is JSDisconnectedException or OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await js.InvokeTeardownAsync("pathingScene.dispose");
    }
}
