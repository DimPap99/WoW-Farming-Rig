@* A button that shows a spinner and refuses clicks while its work runs. *@

<button type="button" class="pa-btn @Class" disabled="@(Busy || Disabled)" title="@Title" @onclick="OnClick">
    @if (Busy)
    {
        <span class="pa-spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <span class="oi oi-@Icon" aria-hidden="true"></span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Title { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
